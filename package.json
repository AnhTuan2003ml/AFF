{
  "name": "aff-hoan-tien",
  "version": "0.1.0",
  "private": true,
  "description": "MVP nền tảng Affiliate hoàn tiền, tối ưu cho mobile và desktop.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "data:clear-demo": "tsx scripts/clear-demo-data.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "shopee:report:test": "tsx scripts/test-shopee-report.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/formbody": "8.0.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/static": "10.1.2",
    "@fastify/view": "12.0.0",
    "argon2": "0.45.1",
    "csv-parse": "7.0.1",
    "fastify": "5.10.0",
    "ioredis": "5.11.1",
    "nodemailer": "9.0.3",
    "nunjucks": "3.2.4",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "26.1.1",
    "@types/nodemailer": "8.0.1",
    "@types/nunjucks": "3.2.6",
    "@types/pg": "8.20.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
