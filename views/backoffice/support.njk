{% extends "backoffice/base.njk" %}
{% from "partials/macros.njk" import status_badge, empty_state, ticket_type_label %}

{% block backoffice_content %}
  <section class="page-heading"><div><span class="eyebrow">ƯU TIÊN THEO SLA</span><h1>Yêu cầu hỗ trợ</h1><p>Không tự kết luận thiếu đơn chỉ từ ảnh; cần tra click và dữ liệu đối tác.</p></div></section>
  <section class="panel">
    {% if tickets.length %}
      <div class="responsive-table">
        <table>
          <thead><tr><th>Ticket</th><th>Người dùng</th><th>Loại</th><th>Nội dung</th><th>SLA</th><th>Trạng thái</th><th>Cập nhật</th></tr></thead>
          <tbody>
            {% for ticket in tickets %}
              <tr>
                <td><a href="/backoffice/support/{{ ticket.id }}"><b>#{{ ticket.id | truncate(8, true, '') }}</b></a><br><small>{{ ticket.created_at | datetime }}</small></td>
                <td>{{ ticket.email }}</td>
                <td>{{ ticket_type_label(ticket.type) }}</td>
                <td><a href="/backoffice/support/{{ ticket.id }}">{{ ticket.subject }}</a></td>
                <td>
                  {% if ticket.overdue %}<b class="st-ticket-sla-overdue">Quá hạn</b><br>{% endif %}
                  {{ ticket.sla_at | datetime }}
                </td>
                <td>{{ status_badge(ticket.status) }}</td>
                <td>
                  <div class="row-actions">
                    <a class="button" href="/backoffice/support/{{ ticket.id }}">Mở ticket</a>
                    {% if currentUser.role != 'AUDITOR' %}
                      <form method="post" action="/backoffice/support/{{ ticket.id }}/status" class="row-actions">
                        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                        <select name="status" aria-label="Đổi trạng thái ticket #{{ ticket.id | truncate(8, true, '') }}">
                          <option value="OPEN" {% if ticket.status == 'OPEN' %}selected{% endif %}>Mới tiếp nhận</option>
                          <option value="IN_PROGRESS" {% if ticket.status == 'IN_PROGRESS' %}selected{% endif %}>Đang xử lý</option>
                          <option value="WAITING_PARTNER" {% if ticket.status == 'WAITING_PARTNER' %}selected{% endif %}>Chờ đối tác</option>
                          <option value="RESOLVED" {% if ticket.status == 'RESOLVED' %}selected{% endif %}>Đã giải quyết</option>
                          <option value="CLOSED" {% if ticket.status == 'CLOSED' %}selected{% endif %}>Đã đóng</option>
                        </select>
                        <button class="button button-small button-primary" type="submit">Lưu</button>
                      </form>
                    {% endif %}
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}{{ empty_state("Không có ticket", "Yêu cầu hỗ trợ mới sẽ xuất hiện tại đây.") }}{% endif %}
  </section>
{% endblock %}
