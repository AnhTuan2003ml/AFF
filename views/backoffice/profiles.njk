{% extends "backoffice/base.njk" %}

{% macro job_status(status) %}
  {% if status == 'DONE' %}
    <span class="status-badge status-positive">Xong</span>
  {% elif status == 'ERROR' %}
    <span class="status-badge status-negative">Lỗi</span>
  {% elif status == 'RUNNING' %}
    <span class="status-badge status-pending">Đang chạy</span>
  {% else %}
    <span class="status-badge status-neutral">Chờ worker</span>
  {% endif %}
{% endmacro %}

{% macro list_label(listType) %}{% if listType == 0 %}Đề xuất{% elif listType == 8 %}Ưu đãi độc quyền{% else %}Bán chạy{% endif %}{% endmacro %}

{% macro job_kind(job) %}
  {% if job.kind == 'LOGIN' %}Mở đăng nhập
  {% elif job.kind == 'FETCH_RANGE' %}Lấy dải trang {{ list_label(job.params.listType) }} {{ job.params.fromPage }}–{{ job.params.toPage }}
  {% elif job.kind == 'FETCH_PAGE' %}Lấy 1 trang {{ list_label(job.params.listType) }} #{{ job.params.pageNo }}
  {% else %}Lấy sản phẩm{% endif %}
{% endmacro %}

{% block backoffice_content %}
  <link rel="stylesheet" href="/assets/backoffice-profiles.css?v={{ assetVersion }}">

  <section class="page-heading">
    <div>
      <span class="eyebrow">CÀI ĐẶT · TRÌNH DUYỆT LẤY DỮ LIỆU</span>
      <h1>Trình duyệt lấy dữ liệu</h1>
      <p>Cấu hình Profile trình duyệt (Browser Control) — dùng chung để lấy dữ liệu Shopee/Lazada cho kho Khám phá.</p>
    </div>
  </section>

  {# ── Một ô Profile ID duy nhất ─────────────────────────────────────── #}
  <section class="panel config-section">
    <header class="admin-section-heading">
      <div><span class="admin-kicker">PROFILE</span><h2>Profile ID (Browser Control)</h2></div>
      {% if currentProfile %}
        <span class="status-badge status-positive">Đang dùng</span>
      {% endif %}
    </header>
    <form method="post" action="/backoffice/profiles" class="bp-id-form" data-validate-form novalidate>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label class="bp-id-field">Profile ID
        <input type="text" name="profileId" maxlength="40" autocomplete="off" spellcheck="false"
               value="{{ currentProfile.id if currentProfile else '' }}"
               placeholder="0054964c-313d-42c2-b627-c6a07b3eba4b" required
               data-required-message="Dán Profile ID từ Browser Control.">
      </label>
      <input type="hidden" name="name" value="{{ currentProfile.name if currentProfile else 'Profile Shopee' }}">
      <button class="button button-primary" type="submit" data-submit-button>Lưu Profile ID</button>
    </form>
    {% if currentProfile %}
      <p class="bp-hint">
        Lấy gần nhất:
        {% if currentProfile.last_fetch_at %}{{ currentProfile.last_fetch_at | datetime }}{% if currentProfile.last_fetched_count %} · {{ currentProfile.last_fetched_count }} sản phẩm{% endif %}{% else %}chưa lấy lần nào{% endif %}.
        {% if currentProfile.last_error %}<span class="field-error">{{ currentProfile.last_error }}</span>{% endif %}
      </p>
    {% endif %}
  </section>

  <section class="order-summary-grid" aria-label="Kho dữ liệu">
    <a href="/app/discover?list=recommend" target="_blank" rel="noopener">
      <span>Kho Đề xuất</span>
      <strong>{{ recommendRange.productCount }}</strong>
      <small>{% if recommendRange.maxPage %}Trang {{ recommendRange.minPage }}–{{ recommendRange.maxPage }} ({{ recommendRange.pageCount }} trang){% else %}Chưa có dữ liệu{% endif %}</small>
    </a>
    <a href="/app/discover?list=best" target="_blank" rel="noopener">
      <span>Kho Bán chạy</span>
      <strong>{{ bestRange.productCount }}</strong>
      <small>{% if bestRange.maxPage %}Trang {{ bestRange.minPage }}–{{ bestRange.maxPage }} ({{ bestRange.pageCount }} trang){% else %}Chưa có dữ liệu{% endif %}</small>
    </a>
    <a href="/app/discover?list=exclusive" target="_blank" rel="noopener">
      <span>Kho Ưu đãi độc quyền</span>
      <strong>{{ exclusiveRange.productCount }}</strong>
      <small>{% if exclusiveRange.maxPage %}Trang {{ exclusiveRange.minPage }}–{{ exclusiveRange.maxPage }} ({{ exclusiveRange.pageCount }} trang){% else %}Chưa có dữ liệu{% endif %}</small>
    </a>
  </section>

  {% if settings.lastError %}
    <aside class="info-strip"><span>!</span><div><b>Lỗi gần nhất</b><p>{{ settings.lastError }}</p></div></aside>
  {% endif %}

  {# ── Deal Hot (voucher) ────────────────────────────────────────────── #}
  <section class="panel config-section">
    <header class="admin-section-heading">
      <div><span class="admin-kicker">🔥 DEAL HOT</span><h2>Sản phẩm voucher giá sốc</h2></div>
    </header>
    <form method="post" action="/backoffice/profiles/fetch-hot">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button class="button button-primary" type="submit">🔥 Lấy Deal Hot ngay</button>
    </form>
  </section>

  {# ── Voucher Shopee ──────────────────────────────────────────────── #}
  <section class="panel config-section">
    <header class="admin-section-heading">
      <div><span class="admin-kicker">🎟️ VOUCHER</span><h2>Mã giảm giá Shopee hôm nay</h2></div>
    </header>
    <form method="post" action="/backoffice/profiles/refresh-vouchers">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button class="button button-primary" type="submit">🎟️ Làm mới voucher ngay</button>
    </form>
  </section>

  {# ── Sản phẩm Lazada (API affiliate) ─────────────────────────────── #}
  <section class="panel config-section">
    <header class="admin-section-heading">
      <div><span class="admin-kicker">🛒 LAZADA</span><h2>Sản phẩm affiliate Lazada</h2></div>
    </header>
    <form method="post" action="/backoffice/profiles/refresh-lazada">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button class="button button-primary" type="submit">🛒 Làm mới sản phẩm Lazada ngay</button>
    </form>
  </section>

  {# ── Lấy dữ liệu theo dải trang ────────────────────────────────────── #}
  <section class="panel config-section">
    <header class="admin-section-heading">
      <div><span class="admin-kicker">LẤY DỮ LIỆU</span><h2>Nạp sản phẩm theo dải trang</h2></div>
    </header>

    <div class="bp-range-grid">
      <form method="post" action="/backoffice/profiles/fetch-range" class="bp-range-card" data-validate-form novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="list" value="recommend">
        <h3>Đề xuất</h3>
        <p class="bp-range-state">{% if recommendRange.maxPage %}Đã có: trang {{ recommendRange.minPage }}–{{ recommendRange.maxPage }}{% else %}Kho trống{% endif %}</p>
        <div class="bp-range-inputs">
          <label>Từ trang
            <input type="number" name="fromPage" min="1" max="500" value="{{ (recommendRange.maxPage + 1) if recommendRange.maxPage else 1 }}" required data-required-message="Nhập trang đầu.">
          </label>
          <span class="bp-range-dash" aria-hidden="true">→</span>
          <label>Đến trang
            <input type="number" name="toPage" min="1" max="500" value="{{ (recommendRange.maxPage + 25) if recommendRange.maxPage else 25 }}" required data-required-message="Nhập trang cuối.">
          </label>
        </div>
        <button class="button button-primary" type="submit" data-submit-button>Nạp Đề xuất</button>
      </form>

      <form method="post" action="/backoffice/profiles/fetch-range" class="bp-range-card" data-validate-form novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="list" value="best">
        <h3>Bán chạy nhất</h3>
        <p class="bp-range-state">{% if bestRange.maxPage %}Đã có: trang {{ bestRange.minPage }}–{{ bestRange.maxPage }}{% else %}Kho trống{% endif %}</p>
        <div class="bp-range-inputs">
          <label>Từ trang
            <input type="number" name="fromPage" min="1" max="500" value="{{ (bestRange.maxPage + 1) if bestRange.maxPage else 1 }}" required data-required-message="Nhập trang đầu.">
          </label>
          <span class="bp-range-dash" aria-hidden="true">→</span>
          <label>Đến trang
            <input type="number" name="toPage" min="1" max="500" value="{{ (bestRange.maxPage + 25) if bestRange.maxPage else 25 }}" required data-required-message="Nhập trang cuối.">
          </label>
        </div>
        <button class="button button-primary" type="submit" data-submit-button>Nạp Bán chạy</button>
      </form>

      <form method="post" action="/backoffice/profiles/fetch-range" class="bp-range-card" data-validate-form novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="list" value="exclusive">
        <h3>Ưu đãi độc quyền</h3>
        <p class="bp-range-state">{% if exclusiveRange.maxPage %}Đã có: trang {{ exclusiveRange.minPage }}–{{ exclusiveRange.maxPage }}{% else %}Kho trống{% endif %}</p>
        <div class="bp-range-inputs">
          <label>Từ trang
            <input type="number" name="fromPage" min="1" max="500" value="{{ (exclusiveRange.maxPage + 1) if exclusiveRange.maxPage else 1 }}" required data-required-message="Nhập trang đầu.">
          </label>
          <span class="bp-range-dash" aria-hidden="true">→</span>
          <label>Đến trang
            <input type="number" name="toPage" min="1" max="500" value="{{ (exclusiveRange.maxPage + 25) if exclusiveRange.maxPage else 25 }}" required data-required-message="Nhập trang cuối.">
          </label>
        </div>
        <button class="button button-primary" type="submit" data-submit-button>Nạp Ưu đãi</button>
      </form>
    </div>
  </section>

  {# ── Lịch lấy tự động ──────────────────────────────────────────────── #}
  <section class="panel config-section">
    <header class="admin-section-heading">
      <div><span class="admin-kicker">TỰ ĐỘNG</span><h2>Lịch làm mới Đề xuất</h2></div>
    </header>
    <form method="post" action="/backoffice/profiles/settings" class="config-form" data-validate-form novalidate>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="bp-settings-grid">
        <label>Tần suất (phút)
          <input type="number" name="intervalMinutes" min="15" max="10080" value="{{ settings.intervalMinutes }}" required data-required-message="Nhập tần suất." data-min-message="Tối thiểu 15 phút." data-max-message="Tối đa 10080 phút.">
          <small>Khoảng cách giữa hai lượt làm mới tự động.</small>
        </label>
        <label>Số trang mỗi lượt
          <input type="number" name="pages" min="1" max="10" value="{{ settings.pages }}" required data-required-message="Nhập số trang." data-min-message="Ít nhất 1." data-max-message="Tối đa 10.">
          <small>Số trang Đề xuất làm mới mỗi lượt tự động.</small>
        </label>
        <label>Sản phẩm hiển thị tối đa
          <input type="number" name="maxItems" min="10" max="200" value="{{ settings.maxItems }}" required data-required-message="Nhập số sản phẩm." data-min-message="Ít nhất 10." data-max-message="Tối đa 200.">
          <small>Vượt số này sẽ ẩn bớt khỏi mục Đề xuất trên Khám phá.</small>
        </label>
      </div>
      <label class="switch-row">
        <input type="checkbox" name="enabled" {% if settings.enabled %}checked{% endif %}>
        <span>Bật làm mới tự động<small>Đến hạn, hệ thống tự làm mới Đề xuất (cần worker đang chạy).</small></span>
      </label>
      <div class="config-save-bar">
        <button class="button button-primary" type="submit" data-submit-button>Lưu cấu hình</button>
      </div>
    </form>
  </section>

  {# ── Nhật ký ───────────────────────────────────────────────────────── #}
  <section class="panel config-section">
    <header class="admin-section-heading">
      <div><span class="admin-kicker">NHẬT KÝ</span><h2>Lệnh gần đây</h2></div>
    </header>
    {% if jobs.length %}
      <div class="responsive-table">
        <table>
          <thead>
            <tr><th>Thời điểm</th><th>Profile</th><th>Lệnh</th><th>Trạng thái</th><th>Ghi chú</th></tr>
          </thead>
          <tbody>
            {% for job in jobs %}
              <tr>
                <td>{{ job.created_at | datetime }}</td>
                <td>{{ job.profile_name }}</td>
                <td>{{ job_kind(job) }}</td>
                <td>{{ job_status(job.status) }}</td>
                <td>{% if job.error %}<span class="field-error">{{ job.error }}</span>{% elif job.finished_at %}Xong {{ job.finished_at | datetime }}{% else %}—{% endif %}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <p class="bp-hint">Chưa có lệnh nào.</p>
    {% endif %}
  </section>
{% endblock %}
