{% extends "backoffice/base.njk" %}

{% macro status_pill(s) %}
  {% if s == 'APPROVED' %}<span class="status-badge status-positive">Đã duyệt</span>
  {% elif s == 'REJECTED' %}<span class="status-badge status-negative">Từ chối</span>
  {% else %}<span class="status-badge status-pending">Chờ duyệt</span>{% endif %}
{% endmacro %}

{% macro kol_table(rows) %}
  <div class="kol-table-wrap">
    <table class="kol-table">
      <thead>
        <tr>
          <th>Người đăng ký</th>
          <th>Email</th>
          <th>Gửi lúc</th>
          <th>Trạng thái</th>
          <th class="kol-t-right">Thao tác</th>
        </tr>
      </thead>
      <tbody>
        {% for a in rows %}
          <tr>
            <td><b>{{ a.full_name }}</b></td>
            <td class="kol-t-muted">{{ a.account_email }}</td>
            <td class="kol-t-muted">{{ a.created_at | datetime }}</td>
            <td>{{ status_pill(a.status) }}</td>
            <td class="kol-t-right">
              <a class="button button-ghost button-small" href="/backoffice/kol/{{ a.id }}">Xem chi tiết →</a>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endmacro %}

{% block backoffice_content %}
  <link rel="stylesheet" href="/assets/kol.css?v={{ assetVersion }}">
  <section class="admin-page-heading">
    <div>
      <span class="admin-kicker">ĐỐI TÁC</span>
      <h1>Duyệt đối tác</h1>
      <p>Duyệt hồ sơ đối tác.</p>
    </div>
  </section>

  <section class="panel data-panel">
    <header class="panel-heading"><div><span class="admin-kicker">CHỜ DUYỆT</span><h2>Hồ sơ mới ({{ applications.pending.length }})</h2></div></header>
    {% if applications.pending.length %}
      {{ kol_table(applications.pending) }}
    {% else %}
      <p class="bp-hint">Chưa có hồ sơ nào chờ duyệt.</p>
    {% endif %}
  </section>

  {% if applications.recent.length %}
    <section class="panel data-panel">
      <header class="panel-heading"><div><span class="admin-kicker">GẦN ĐÂY</span><h2>Đã xử lý</h2></div></header>
      {{ kol_table(applications.recent) }}
    </section>
  {% endif %}
{% endblock %}
