{% extends "base.njk" %}
{% from "partials/icons.njk" import icon %}
{% from "partials/macros.njk" import role_label %}

{% block body %}
  <link rel="stylesheet" href="/assets/dashboard.css?v={{ assetVersion }}">
  <link rel="stylesheet" href="/assets/shoptik-premium-patch.css?v={{ assetVersion }}">
  <link rel="stylesheet" href="/assets/app-shell.css?v={{ assetVersion }}">
  {# Khung quản trị dùng CHUNG hệ shell st-* với app (app-shell.css):
     sidebar nhóm chức năng + topbar mỏng + tabbar mobile. Class
     backoffice-shell giữ lại cho CSS nội dung trang (dashboard.css,
     shoptik-premium-patch.css) — chrome cũ commerce-* đã bỏ hẳn. #}
  <div class="backoffice-shell st-app">
    <div class="st-layout">
      <aside class="st-sidebar" data-sidebar>
        <div class="st-sidebar-head">
          <a class="st-brand" href="/backoffice/console" aria-label="ShopTik">
            <img src="/assets/images/icon.png" alt="" aria-hidden="true">
            <span>SHOPTIK</span><small>QUẢN TRỊ</small>
          </a>
          <button class="st-sidebar-close" type="button" aria-label="Đóng menu" data-sidebar-close>×</button>
        </div>

        <nav class="st-nav" aria-label="Quản trị">
          <p class="st-nav-group">Hôm nay</p>
          <a href="/backoffice/console" {% if backofficeSection == 'dashboard' %}class="active" aria-current="page"{% endif %}>{{ icon('dashboard') }}<span>Tổng quan</span></a>
          <a href="/backoffice/reconciliation" {% if backofficeSection == 'orders' %}class="active" aria-current="page"{% endif %}>{{ icon('orders') }}<span>Đơn &amp; hoàn tiền</span>{% if backofficeOrdersPendingCount > 0 %}<em class="st-nav-badge" aria-label="{{ backofficeOrdersPendingCount }} đơn chờ xử lý">{{ backofficeOrdersPendingCount }}</em>{% endif %}</a>
          <a href="/backoffice/withdrawals" {% if backofficeSection == 'withdrawals' %}class="active" aria-current="page"{% endif %}>{{ icon('withdraw') }}<span>Yêu cầu rút tiền</span>{% if backofficeWithdrawalsPendingCount > 0 %}<em class="st-nav-badge" aria-label="{{ backofficeWithdrawalsPendingCount }} yêu cầu rút tiền chờ xử lý">{{ backofficeWithdrawalsPendingCount }}</em>{% endif %}</a>
          <a href="/backoffice/support" {% if backofficeSection == 'support' %}class="active" aria-current="page"{% endif %}>{{ icon('support') }}<span>Hỗ trợ</span>{% if backofficeSupportPendingCount > 0 %}<em class="st-nav-badge" aria-label="{{ backofficeSupportPendingCount }} yêu cầu hỗ trợ chờ xử lý">{{ backofficeSupportPendingCount }}</em>{% endif %}</a>
          <p class="st-nav-group">Quản lý</p>
          <a href="/backoffice/accounts" {% if backofficeSection == 'users' %}class="active" aria-current="page"{% endif %}>{{ icon('users') }}<span>Người dùng &amp; quyền</span></a>
          <a href="/backoffice/banks" {% if backofficeSection == 'banks' %}class="active" aria-current="page"{% endif %}>{{ icon('bank') }}<span>Tài khoản ngân hàng</span></a>
          <a href="/backoffice/products" {% if backofficeSection == 'products' %}class="active" aria-current="page"{% endif %}>{{ icon('discover') }}<span>Khám phá</span></a>
          <a href="/backoffice/missions" {% if backofficeSection == 'missions' %}class="active" aria-current="page"{% endif %}>{{ icon('mission') }}<span>Nhiệm vụ</span>{% if backofficeMissionsPendingCount > 0 %}<em class="st-nav-badge" aria-label="{{ backofficeMissionsPendingCount }} yêu cầu nhận thưởng chờ duyệt">{{ backofficeMissionsPendingCount }}</em>{% endif %}</a>
          <a href="/backoffice/revenue" {% if backofficeSection == 'revenue' %}class="active" aria-current="page"{% endif %}>{{ icon('wallet') }}<span>Doanh thu</span></a>
          <p class="st-nav-group">Hệ thống</p>
          <a href="/backoffice/sync" {% if backofficeSection == 'sync' %}class="active" aria-current="page"{% endif %}>{{ icon('refresh') }}<span>Đồng bộ sàn</span></a>
          <a href="/backoffice/config" {% if backofficeSection == 'config' %}class="active" aria-current="page"{% endif %}>{{ icon('settings') }}<span>Cấu hình nghiệp vụ</span></a>
          <a href="/backoffice/audit" {% if backofficeSection == 'audit' %}class="active" aria-current="page"{% endif %}>{{ icon('audit') }}<span>Nhật ký</span></a>
        </nav>

      </aside>

      <div class="st-main">
        <header class="st-topbar">
          <button class="st-topbar-open" type="button" aria-label="Mở menu" data-sidebar-open>
            <span></span><span></span><span></span>
          </button>
          <a class="st-brand st-topbar-brand" href="/backoffice/console" aria-label="ShopTik">
            <img src="/assets/images/icon.png" alt="" aria-hidden="true">
            <span>SHOPTIK</span>
          </a>
          <div class="st-topbar-spacer"></div>

          {% include "partials/theme-button.njk" %}

          <div class="st-menu">
            <button type="button" class="st-account" data-menu-trigger aria-haspopup="true" aria-expanded="false" title="{{ currentUser.email }}">
              <span class="st-avatar" aria-hidden="true">{{ (currentUser.fullName or currentUser.email or '?') | first | upper }}</span>
              <span class="st-account-email">{{ currentUser.email }}</span>
              <svg class="st-menu-caret" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg>
            </button>
            <div class="st-menu-panel" data-menu>
              <div class="st-menu-head">
                <b>{{ role_label(currentUser.role) }}</b>
                <small>{{ currentUser.email }}</small>
              </div>
              <a href="/app">{{ icon('discover') }}<span>Về ứng dụng</span></a>
              <div class="st-menu-divider" role="separator"></div>
              <form method="post" action="/dang-xuat">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <button class="st-menu-logout button-ghost" type="submit">{{ icon('logout') }}<span>Đăng xuất</span></button>
              </form>
            </div>
          </div>
        </header>

        <main class="st-content" id="main-content" tabindex="-1">
          {% include "partials/flash.njk" %}
          {% block backoffice_content %}{% endblock %}
        </main>
      </div>
    </div>

    <button class="st-scrim" type="button" aria-label="Đóng menu" data-sidebar-close></button>

    <nav class="st-tabbar" aria-label="Điều hướng quản trị di động">
      <a href="/backoffice/console" {% if backofficeSection == 'dashboard' %}class="active" aria-current="page"{% endif %}>{{ icon('dashboard') }}<b>Tổng quan</b></a>
      <a href="/backoffice/reconciliation" {% if backofficeSection == 'orders' %}class="active" aria-current="page"{% endif %}>{{ icon('orders') }}<b>Đơn</b></a>
      <a href="/backoffice/withdrawals" {% if backofficeSection == 'withdrawals' %}class="active" aria-current="page"{% endif %}>{{ icon('withdraw') }}<b>Rút tiền</b></a>
      <a href="/backoffice/accounts" {% if backofficeSection == 'users' %}class="active" aria-current="page"{% endif %}>{{ icon('users') }}<b>Người dùng</b></a>
      <button type="button" data-sidebar-open>{{ icon('more') }}<b>Thêm</b></button>
    </nav>
  </div>
{% endblock %}
