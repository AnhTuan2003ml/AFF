{% extends "base.njk" %}

{#
  Khung trang đăng nhập / đăng ký dựng theo AuthModal của bản thiết kế MB:
  thẻ trắng bo lớn, ĐẦU THẺ là dải gradient navy mang nhận diện + nhãn bảo
  mật, dưới đó là biểu mẫu.

  Trang con ghi đè auth_head_title / auth_head_sub để đổi chữ trên dải navy.
  Chuyển qua lại giữa đăng nhập và đăng ký đi bằng dòng link cuối biểu mẫu.
#}

{% block html_attrs %}data-theme="light"{% endblock %}

{% block body %}
  <main class="auth-shell auth-commerce" id="main-content">
    <section class="auth-commerce-story" aria-label="Giới thiệu ShopTik">
      <div class="auth-commerce-media" aria-hidden="true"></div>
      <div class="auth-commerce-story-content">
        <a class="auth-commerce-brand" href="/" aria-label="ShopTik - Trang chủ">
          <img src="/assets/images/icon.png?v={{ assetVersion }}" alt="">
          <span><b>SHOP</b><strong>TIK</strong><small>CASHBACK</small></span>
        </a>

        <div class="auth-commerce-message">
          <span class="auth-commerce-kicker">HOÀN TIỀN ĐA SÀN</span>
          {# Không có dấu chấm cuối dòng: chữ in hoa cỡ lớn mà chấm câu trông
             rất rối. Mỗi dòng là một <span> để đặt được leading riêng. #}
          <h1><span>MUA ĐÚNG LINK</span><span>NHẬN ĐÚNG TIỀN</span></h1>
          <p>Dán link sản phẩm, mua qua liên kết Affiliate và theo dõi tiền hoàn minh bạch trên một nền tảng.</p>

          {# Vật thể chính của cột: một "hoá đơn hoàn tiền" bằng kính mờ. Nói
             thẳng lời hứa của sản phẩm bằng con số thay vì mô tả chung chung. #}
          <figure class="auth-receipt">
            <figcaption>
              <span>Ví dụ một đơn hàng</span>
              <b class="auth-receipt-rate">Hoàn 8%</b>
            </figcaption>
            <div class="auth-receipt-row">
              <span>Bạn thanh toán trên sàn</span>
              <b>500.000 ₫</b>
            </div>
            <div class="auth-receipt-tear" aria-hidden="true"></div>
            <div class="auth-receipt-row is-total">
              <span>ShopTik hoàn về ví</span>
              <b>+ 40.000 ₫</b>
            </div>
          </figure>

          <ul class="auth-commerce-points">
            <li>
              <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg></span>
              <div><b>Hoàn tiền tự động</b><small>Không cần khai báo đơn, không cần chụp màn hình</small></div>
            </li>
            <li>
              <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7.5h16v11a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5z"/><path d="M4 7.5 7 4h10l3 3.5"/><path d="M9.5 12h5"/></svg></span>
              <div><b>Rút về mọi ngân hàng</b><small>Vietcombank, Techcombank, MB, BIDV, VPBank…</small></div>
            </li>
            <li>
              <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3.5 5 6.5v5.2c0 4 2.9 7.4 7 8.8 4.1-1.4 7-4.8 7-8.8V6.5z"/><path d="m9.2 12 2 2 3.6-3.8"/></svg></span>
              <div><b>Đối soát minh bạch</b><small>Mọi biến động ví đều có lịch sử kiểm tra được</small></div>
            </li>
          </ul>
        </div>

        <div class="auth-commerce-trust" aria-label="Điểm nổi bật">
          <span>SHOPEE</span>
          <span>TIKTOK SHOP</span>
          <span>LAZADA</span>
        </div>
      </div>
    </section>

    <section class="auth-panel auth-commerce-panel">
      <div class="auth-card">
        <header class="auth-card-header">
          <div class="auth-card-header-top">
            <span class="auth-card-mark" aria-hidden="true">
              <img src="/assets/images/icon.png?v={{ assetVersion }}" alt="">
            </span>
            <div class="auth-card-header-copy">
              <div class="auth-card-header-line">
                <h1>{% block auth_head_title %}Tài khoản hoàn tiền{% endblock %}</h1>
                
              </div>
              <p>{% block auth_head_sub %}Đăng nhập để nhận hoàn tiền và theo dõi đơn{% endblock %}</p>
            </div>
          </div>
        </header>

        <div class="auth-card-body">
          {% include "partials/flash.njk" %}
          {% if formError %}<div class="form-error" role="alert">{{ formError }}</div>{% endif %}
          {% block auth_content %}{% endblock %}
        </div>

      </div>
    </section>
  </main>

  <footer class="auth-page-footer">
    <div class="px-footer-top">
      <div class="px-footer-brand">
        <a href="/"><img src="/assets/images/icon.png?v={{ assetVersion }}" alt=""><strong>ShopTik</strong></a>
        <p>Mua đúng link. Theo dõi đúng đơn. Nhận đúng tiền hoàn.</p>
      </div>
      <div class="px-footer-col"><b>ShopTik</b><a href="/">Trang chủ</a><a href="/dang-nhap">Đăng nhập</a><a href="/dang-ky">Tạo tài khoản</a></div>
      <div class="px-footer-col"><b>Pháp lý</b><a href="/dieu-khoan" data-policy-sheet data-policy-url="/dieu-khoan" data-policy-title="Điều khoản">Điều khoản</a><a href="/quyen-rieng-tu" data-policy-sheet data-policy-url="/quyen-rieng-tu" data-policy-title="Quyền riêng tư">Quyền riêng tư</a><a href="/chinh-sach-nguoi-dung" data-policy-sheet data-policy-url="/chinh-sach-nguoi-dung/noi-dung" data-policy-title="Chính sách người dùng">Chính sách người dùng</a></div>
      <div class="px-footer-col"><b>Nền tảng</b><a href="/dang-ky">Shopee</a><a href="/dang-ky">TikTok Shop</a><a href="/dang-ky">Lazada</a></div>
    </div>

    <div class="px-footer-apps">
      <div class="px-footer-apps-copy">
        <b>Tải ứng dụng ShopTik</b>
        <small>Theo dõi đơn và nhận tiền hoàn ngay trên điện thoại.</small>
      </div>
      <div class="px-stores">
        <span class="px-store" role="img" aria-label="App Store — sắp ra mắt">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.4 12.7c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.7-1.3-.1-2.5.8-3.1.8s-1.6-.7-2.7-.7c-1.4 0-2.7.8-3.4 2-1.4 2.5-.4 6.2 1 8.2.7 1 1.5 2.1 2.6 2.1 1 0 1.4-.7 2.7-.7s1.6.7 2.7.6c1.1 0 1.8-1 2.5-2 .8-1.1 1.1-2.2 1.1-2.3 0 0-2.2-.8-2.2-3.1z"/><path d="M14.6 6.3c.6-.7 1-1.6.9-2.6-.8 0-1.9.6-2.5 1.3-.5.6-1 1.6-.9 2.5.9.1 1.8-.5 2.5-1.2z"/></svg>
          <span><small>Tải về trên</small><b>App Store</b></span>
        </span>
        <span class="px-store" role="img" aria-label="Google Play — sắp ra mắt">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3.2v17.6c0 .5.5.8.9.6l9.6-5.6-2.6-2.6z"/><path d="M4 3.2 11.9 11l2.6-2.6L4.9 2.6c-.4-.2-.9.1-.9.6z"/><path d="m17.6 9.9-3.1-1.5L11.9 11l2.6 2.6 3.1-1.8c.6-.4.6-1.5 0-1.9z"/></svg>
          <span><small>Tải về trên</small><b>Google Play</b></span>
        </span>
        <span class="px-store-soon">Sắp ra mắt</span>
      </div>
    </div>

    <div class="px-footer-bottom"><span>© 2026 ShopTik</span><span>Shopee · TikTok Shop · Lazada</span></div>
  </footer>

  {% include "partials/policy-sheet.njk" %}
  <script src="/assets/policy-sheet.js?v={{ assetVersion }}" defer></script>
{% endblock %}
