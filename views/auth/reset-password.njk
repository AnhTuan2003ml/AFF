{% extends "auth/auth-commerce-base.njk" %}

{% block auth_head_title %}Đặt lại mật khẩu{% endblock %}
{% block auth_head_sub %}Xác nhận chủ tài khoản rồi đặt mật khẩu mới{% endblock %}

{% block auth_content %}
  {# Tiêu đề đã nằm trên dải navy đầu thẻ. #}
  <p class="auth-note">Mã xác nhận đã được gửi tới <strong>{{ maskedEmail }}</strong>.</p>
  <form method="post" action="/dat-lai-mat-khau" class="stack-form" data-validate-form novalidate>
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <label for="reset-code-input">Mã xác nhận
      <input id="reset-code-input" class="otp-input" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required autofocus data-required-message="Vui lòng nhập mã xác nhận." data-pattern-message="Mã xác nhận gồm 6 chữ số.">
      <small class="field-error" id="reset-code-input-error" hidden></small>
    </label>
    <label for="reset-password-input">Mật khẩu mới
      <span class="password-field">
        <input id="reset-password-input" type="password" name="password" autocomplete="new-password" minlength="10" maxlength="128" data-password required data-required-message="Vui lòng nhập mật khẩu mới." data-minlength-message="Mật khẩu cần ít nhất 10 ký tự.">
        <button type="button" data-toggle-password aria-pressed="false" aria-label="Hiện mật khẩu"><svg class="icon-eye" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3.2"/></svg><svg class="icon-eye-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M9.9 5.8A9.6 9.6 0 0 1 12 5.5c6 0 9.5 6.5 9.5 6.5a17 17 0 0 1-3 3.9M6.4 7.6A17 17 0 0 0 2.5 12S6 18.5 12 18.5c1 0 1.9-.2 2.8-.5"/><path d="M10 10a3.2 3.2 0 0 0 4.3 4.3"/><path d="m4 4 16 16"/></svg></button>
      </span>
      <small class="field-error" id="reset-password-input-error" hidden></small>
    </label>
    <label for="reset-password-confirm-input">Nhập lại mật khẩu
      <input id="reset-password-confirm-input" type="password" name="passwordConfirm" autocomplete="new-password" minlength="10" maxlength="128" required data-required-message="Vui lòng nhập lại mật khẩu.">
      <small class="field-error" id="reset-password-confirm-input-error" hidden></small>
    </label>
    <button class="button button-primary button-block button-large" type="submit" data-submit-button>Đổi mật khẩu</button>
  </form>
  <p class="helper-note">Chưa nhận được mã hoặc mã đã hết hạn? <a href="/quen-mat-khau">Gửi lại từ đầu</a>.</p>
{% endblock %}
