{% extends "auth/auth-commerce-base.njk" %}

{% block auth_content %}
  <header class="auth-heading">
    <h2>Quên mật khẩu</h2>
    <p>Nhập email đăng ký. Nếu tài khoản tồn tại, chúng tôi sẽ gửi mã xác nhận.</p>
  </header>
  <form method="post" action="/quen-mat-khau" class="stack-form" data-validate-form novalidate>
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <label for="forgot-email-input">Email
      <input id="forgot-email-input" type="email" name="email" autocomplete="email" maxlength="254" required autofocus data-required-message="Vui lòng nhập email." data-pattern-message="Email chưa đúng định dạng.">
      <small class="field-error" id="forgot-email-input-error" hidden></small>
    </label>
    <button class="button button-primary button-block button-large" type="submit" data-submit-button>Gửi mã đặt lại</button>
  </form>
  <p class="auth-switch"><a href="/dang-nhap">← Quay lại đăng nhập</a></p>
{% endblock %}
