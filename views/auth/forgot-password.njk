{% extends "auth/auth-commerce-base.njk" %}

{% block auth_head_title %}{{ t('Quên mật khẩu', 'Forgot password') }}{% endblock %}
{% block auth_head_sub %}{{ t('Nhập email đăng ký để nhận mã xác nhận', 'Enter your registered email to receive a confirmation code') }}{% endblock %}

{% block auth_content %}
  {# Tiêu đề đã nằm trên dải navy đầu thẻ; ở đây chỉ giữ phần dặn dò. #}
  <p class="auth-note">{{ t('Nếu tài khoản tồn tại, chúng tôi sẽ gửi mã xác nhận tới email đó.', 'If the account exists, we’ll send a confirmation code to that email.') }}</p>
  <form method="post" action="/quen-mat-khau" class="stack-form" data-validate-form novalidate>
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <label for="forgot-email-input">Email
      <input id="forgot-email-input" type="email" name="email" autocomplete="email" maxlength="254" required autofocus data-required-message="{{ t('Vui lòng nhập email.', 'Please enter your email.') }}" data-pattern-message="{{ t('Email chưa đúng định dạng.', 'Invalid email format.') }}">
      <small class="field-error" id="forgot-email-input-error" hidden></small>
    </label>
    <button class="button button-primary button-block button-large" type="submit" data-submit-button>{{ t('Gửi mã đặt lại', 'Send reset code') }}</button>
  </form>
  <p class="auth-switch"><a href="/dang-nhap">← {{ t('Quay lại đăng nhập', 'Back to sign in') }}</a></p>
{% endblock %}
