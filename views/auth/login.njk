{% extends "auth/auth-commerce-base.njk" %}

{% block auth_head_title %}{{ t('Đăng nhập', 'Sign in') }}{% endblock %}
{% block auth_head_sub %}{{ t('Vào ví để xem tiền hoàn và tạo lệnh rút', 'Access your wallet to view cashback and request withdrawals') }}{% endblock %}

{% block auth_content %}
  <form method="post" action="/dang-nhap" class="stack-form login-form" data-validate-form novalidate>
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <input type="hidden" name="next" value="{{ next or '' }}">

    <label class="login-field" for="login-email-input">
      <span class="auth-field-label">Email</span>
      <span class="auth-input-shell">
        <span class="login-field-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5z"></path><path d="m5.5 7 6.5 5 6.5-5"></path></svg>
        </span>
        <input id="login-email-input" type="email" name="email" autocomplete="email" maxlength="254" placeholder="ten@email.com" value="{{ values.email or '' }}" required autofocus data-required-message="{{ t('Vui lòng nhập email.', 'Please enter your email.') }}" data-pattern-message="{{ t('Email chưa đúng định dạng.', 'Invalid email format.') }}">
      </span>
      <small class="field-error" id="login-email-input-error" hidden></small>
    </label>

    <label class="login-field" for="login-password-input">
      <span class="auth-field-label">{{ t('Mật khẩu', 'Password') }}</span>
      <span class="auth-input-shell password-field">
        <span class="login-field-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M7 10V8a5 5 0 0 1 10 0v2"></path><rect x="5" y="10" width="14" height="10" rx="3"></rect><circle cx="12" cy="15" r="1"></circle></svg>
        </span>
        <input id="login-password-input" type="password" name="password" autocomplete="current-password" maxlength="128" placeholder="{{ t('Nhập mật khẩu', 'Enter password') }}" data-password required data-required-message="{{ t('Vui lòng nhập mật khẩu.', 'Please enter your password.') }}">
        <button type="button" data-toggle-password aria-pressed="false" aria-label="{{ t('Hiện mật khẩu', 'Show password') }}"><svg class="icon-eye" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3.2"/></svg><svg class="icon-eye-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M9.9 5.8A9.6 9.6 0 0 1 12 5.5c6 0 9.5 6.5 9.5 6.5a17 17 0 0 1-3 3.9M6.4 7.6A17 17 0 0 0 2.5 12S6 18.5 12 18.5c1 0 1.9-.2 2.8-.5"/><path d="M10 10a3.2 3.2 0 0 0 4.3 4.3"/><path d="m4 4 16 16"/></svg></button>
      </span>
      <small class="field-error" id="login-password-input-error" hidden></small>
    </label>

    <div class="login-inline-actions">
      <label class="remember-check">
        <input type="checkbox" name="remember" value="on" data-remember-checkbox>
        <span>{{ t('Ghi nhớ đăng nhập', 'Remember me') }}</span>
      </label>
      <a href="/quen-mat-khau">{{ t('Quên mật khẩu?', 'Forgot password?') }}</a>
    </div>
    <button class="button button-primary button-block button-large login-submit" type="submit" data-submit-button>
      <span>{{ t('Đăng nhập', 'Sign in') }}</span>
      <span aria-hidden="true">→</span>
    </button>
  </form>

  {% if googleEnabled %}
    <div class="auth-divider"><span>{{ t('hoặc', 'or') }}</span></div>
    <a class="button button-block button-large button-google" href="/auth/google{% if next %}?next={{ next | urlencode }}{% endif %}">
      {% include "partials/google-logo.njk" %}
      <span>{{ t('Tiếp tục với Google', 'Continue with Google') }}</span>
    </a>
  {% endif %}

  <p class="auth-switch login-register-link">{{ t('Chưa có tài khoản?', 'No account yet?') }} <a href="/dang-ky">{{ t('Tạo tài khoản', 'Create account') }}</a></p>
{% endblock %}

{% block page_scripts %}
  <script src="/assets/login-remember.js?v={{ assetVersion }}" defer></script>
{% endblock %}
