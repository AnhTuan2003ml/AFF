{% extends "auth/auth-commerce-base.njk" %}

{% block auth_content %}
  <header class="auth-heading">
    <span class="eyebrow">BƯỚC 2/2</span>
    <h2>Nhập mã OTP</h2>
    <p>Mã OTP 6 số đã được gửi tới <strong>{{ maskedEmail }}</strong>.</p>
  </header>
  <form method="post" action="/xac-thuc-email" class="stack-form" data-validate-form novalidate>
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <label for="verify-code-input">Mã xác nhận
      <input id="verify-code-input" class="otp-input" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="000000" autofocus required data-required-message="Vui lòng nhập mã xác nhận." data-pattern-message="Mã xác nhận gồm 6 chữ số.">
      <small class="field-error" id="verify-code-input-error" hidden></small>
    </label>
    <button class="button button-primary button-block button-large" type="submit" data-submit-button>Xác thực tài khoản</button>
  </form>
  <form method="post" action="/xac-thuc-email/gui-lai" class="inline-form">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <button class="text-button" type="submit">Gửi lại mã</button>
  </form>
  <p class="helper-note">Mã có hiệu lực trong thời gian ngắn. Nếu chưa thấy email, hãy kiểm tra cả mục Spam/Thư rác rồi mới bấm gửi lại.</p>
{% endblock %}
