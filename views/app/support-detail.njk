{% extends "app/app-base.njk" %}
{% from "partials/macros.njk" import status_badge, ticket_type_label %}

{% block app_content %}
  <section class="page-heading">
    <div>
      <h1>Yêu cầu #{{ ticket.id | truncate(8, true, '') }}</h1>
      <p><a class="st-back-link" href="/app/support">← Quay lại danh sách hỗ trợ</a></p>
    </div>
  </section>

  <div class="st-ticket-detail">
    <section class="panel st-ticket-info">
      <header class="panel-heading"><div><h2>{{ ticket.subject }}</h2></div></header>
      <dl class="st-ticket-facts">
        <div><dt>Loại yêu cầu</dt><dd>{{ ticket_type_label(ticket.type) }}</dd></div>
        <div><dt>Trạng thái</dt><dd>{{ status_badge(ticket.status) }}</dd></div>
        <div>
          <dt>Hạn phản hồi</dt>
          <dd>
            {% if ticket.overdue %}<b class="st-ticket-sla-overdue">Quá hạn ({{ ticket.sla_at | datetime }})</b>
            {% else %}{{ ticket.sla_at | datetime }}{% endif %}
          </dd>
        </div>
        {% if ticket.related_order_id %}
          <div><dt>Đơn liên quan</dt><dd>#{{ ticket.related_order_id }}</dd></div>
        {% endif %}
        <div><dt>Gửi lúc</dt><dd>{{ ticket.created_at | datetime }}</dd></div>
      </dl>
    </section>

    <section class="panel st-ticket-thread">
      <header class="panel-heading"><div><h2>Trao đổi</h2></div></header>
      <ol class="st-thread">
        <li class="st-thread-item st-thread-user">
          <b>Bạn</b>
          <p>{{ ticket.description }}</p>
          <time>{{ ticket.created_at | datetime }}</time>
        </li>
        {% for reply in replies %}
          <li class="st-thread-item {{ 'st-thread-staff' if reply.author_role == 'STAFF' else 'st-thread-user' }}">
            <b>{{ 'Nhân viên hỗ trợ' if reply.author_role == 'STAFF' else 'Bạn' }}</b>
            <p>{{ reply.body }}</p>
            <time>{{ reply.created_at | datetime }}</time>
          </li>
        {% endfor %}
      </ol>

      {% if not ticket.closed %}
        <form method="post" action="/app/support/{{ ticket.id }}/reply" class="stack-form st-thread-form" data-validate-form novalidate>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <label for="support-reply-input">Bổ sung thông tin
            <textarea id="support-reply-input" name="body" rows="3" minlength="2" maxlength="3000" required data-required-message="Vui lòng nhập nội dung phản hồi."></textarea>
            <small class="field-error" id="support-reply-input-error" hidden></small>
          </label>
          <button class="button button-primary" type="submit" data-submit-button>Gửi phản hồi</button>
        </form>
      {% else %}
        <p class="st-thread-closed">Ticket đã đóng — cần hỗ trợ thêm, hãy tạo yêu cầu mới.</p>
      {% endif %}
    </section>
  </div>
{% endblock %}
