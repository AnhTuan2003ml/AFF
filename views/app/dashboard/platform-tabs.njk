{% from "partials/platform-logos.njk" import platform_logo %}

{#
  Đây là KHU QUẢNG BÁ SÀN, không phải bộ chọn. purchase.js tự nhận diện sàn từ
  URL được dán nên người dùng không cần chọn Shopee/TikTok/Lazada thủ công.
  ui-motion.js tự luân phiên ba slide và tạm dừng khi tab không còn hiển thị.
#}
<div class="lux-platform-showcase" data-platform-showcase aria-label="ShopTik hỗ trợ Shopee, TikTok Shop và Lazada">
  <article class="lux-platform-slide is-active" data-platform-ad="SHOPEE" aria-hidden="false">
    <span class="lux-platform-logo">{{ platform_logo('SHOPEE') }}</span>
    <span class="lux-platform-copy"><small>ĐỐI TÁC MUA SẮM</small><strong>Shopee</strong><span>Dán link Shopee, ShopTik tự nhận diện và kiểm tra hoàn tiền.</span></span>
    <span class="lux-platform-kicker">Tự nhận diện link</span>
  </article>
  <article class="lux-platform-slide" data-platform-ad="TIKTOK" aria-hidden="true">
    <span class="lux-platform-logo">{{ platform_logo('TIKTOK') }}</span>
    <span class="lux-platform-copy"><small>ĐỐI TÁC MUA SẮM</small><strong>TikTok Shop</strong><span>Từ video đến giỏ hàng — link được xử lý tự động trong cùng một luồng.</span></span>
    <span class="lux-platform-kicker">Mua qua ShopTik</span>
  </article>
  <article class="lux-platform-slide" data-platform-ad="LAZADA" aria-hidden="true">
    <span class="lux-platform-logo">{{ platform_logo('LAZADA') }}</span>
    <span class="lux-platform-copy"><small>ĐỐI TÁC MUA SẮM</small><strong>Lazada</strong><span>Tra cứu sản phẩm và khoản hoàn dự kiến mà không cần đổi chế độ.</span></span>
    <span class="lux-platform-kicker">3 sàn · 1 trải nghiệm</span>
  </article>
  <div class="lux-platform-dots" aria-hidden="true">
    <button class="lux-platform-dot is-active" type="button" tabindex="-1"></button>
    <button class="lux-platform-dot" type="button" tabindex="-1"></button>
    <button class="lux-platform-dot" type="button" tabindex="-1"></button>
  </div>
</div>
