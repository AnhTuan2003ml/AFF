{% from "partials/platform-logos.njk" import platform_logo %}

{% set platforms = [
  { code: 'SHOPEE', label: 'Shopee', className: 'platform-shopee', badge: 'HOT' },
  { code: 'TIKTOK', label: 'TikTok', className: 'platform-tiktok', badge: 'LIVE' },
  { code: 'LAZADA', label: 'Lazada', className: 'platform-lazada', badge: 'HOT' }
] %}

{% for platform in platforms %}
  <button
    type="button"
    class="platform-tab {{ platform.className }}{% if defaultPlatform == platform.code %} active{% endif %}"
    data-platform-tab="{{ platform.code }}"
    data-platform-label="{{ platform.label }}"
    role="tab"
    aria-selected="{% if defaultPlatform == platform.code %}true{% else %}false{% endif %}"
  >
    <span class="platform-card-badge">{{ platform.badge }}</span>
    <span class="platform-logo">{{ platform_logo(platform.code) }}</span>
    <strong>{{ platform.label }}</strong>
    <small>Hoàn tiền lên tới {{ cashbackRate }}%</small>
  </button>
{% endfor %}
