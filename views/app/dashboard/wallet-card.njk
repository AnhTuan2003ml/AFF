{#
  Khoang PHẢI của hero — thẻ ví navy, thay cho panel "bảo chứng" tĩnh của bản
  thiết kế bằng số liệu thật của người dùng. Thanh tiến độ đo khoảng cách tới
  mức rút tối thiểu, đặt bề rộng bằng class (CSP chặn style nội tuyến).
#}
{% set available = balances.available or 0 %}
{% set minWithdraw = minWithdrawAmountVnd or 0 %}
{% set reachedWithdraw = minWithdraw <= 0 or available >= minWithdraw %}
{% set progressRaw = 100 if reachedWithdraw else ((available * 100 / minWithdraw) | round | int) %}
{% set progressStep = ((progressRaw / 10) | round | int) * 10 %}

{% if not currentUser %}
<section class="mb-points mb-points-guest" aria-label="{{ t('Ví hoàn tiền', 'Cashback wallet') }}">
  <div>
    <span class="mb-points-label">{{ t('Ví hoàn tiền', 'Cashback wallet') }}</span>
    <b class="mb-points-value">{{ t('Đăng nhập để nhận', 'Sign in to earn') }}</b>
  </div>
  <p class="mb-points-guest-copy">{{ t('Có link? Đưa Camio! Xem trước tiền hoàn ngay — đăng nhập để mua qua ShopTik và nhận tiền về ví.', 'Got a link? Give it to Camio! Preview your cashback now — sign in to buy via ShopTik and get money to your wallet.') }}</p>
  <div class="mb-points-actions">
    <a class="is-primary" href="/dang-nhap">{{ t('Đăng nhập', 'Sign in') }}</a>
    <a href="/dang-ky">{{ t('Tạo tài khoản', 'Create account') }}</a>
  </div>
</section>
{% else %}
<section class="mb-points" aria-label="{{ t('Ví hoàn tiền', 'Cashback wallet') }}">
  <div class="mb-points-top">
    <div>
      <span class="mb-points-label">{{ t('Số dư khả dụng', 'Available balance') }}</span>
      <b class="mb-points-value">{{ available | vnd }}</b>
    </div>
    <div class="mb-points-side">
      <span class="mb-chip-glass">{{ t('Hoàn tới', 'Up to') }} {{ cashbackRate }}%</span>
      <a class="mb-points-pending" href="/app/orders">
        {{ t('Đang chờ:', 'Pending:') }} <strong>{{ balances.pending | vnd }}</strong> ›
      </a>
    </div>
  </div>

  <div class="mb-points-bar">
    <div>
      <span>{{ t('Đã mua qua ShopTik', 'Bought via ShopTik') }}</span>
      <b>{{ purchaseStats.products or 0 }} {{ t('sản phẩm', 'products') }}</b>
    </div>
    <div class="mb-points-actions">
      <a href="/app/wallet">{{ t('Xem ví', 'View wallet') }}</a>
      <a class="is-primary" href="/app/withdrawals">{{ t('Rút tiền', 'Withdraw') }} ›</a>
    </div>
  </div>

  <div class="mb-points-progress">
    <div class="mb-points-progress-copy">
      {% if reachedWithdraw %}
        <p>{{ t('Số dư đã đủ điều kiện rút về ngân hàng — tạo lệnh bất cứ lúc nào.', 'Your balance is eligible to withdraw to your bank — request anytime.') }}</p>
      {% else %}
        <p>{{ t('Thêm', 'Add') }} <strong>{{ (minWithdraw - available) | vnd }}</strong> {{ t('nữa là đủ mức rút tối thiểu', 'more to reach the minimum withdrawal of') }} {{ minWithdraw | vnd }}.</p>
      {% endif %}
      <em>{{ progressRaw }}%</em>
    </div>
    <div class="mb-points-track">
      <i class="mb-w-{{ progressStep }}" aria-hidden="true"></i>
    </div>
  </div>
</section>
{% endif %}
