{#
  Khoang TRÁI của hero: dán link → tra cứu tiền hoàn.
  Mọi hook JS của purchase.js giữ nguyên tên: [data-product-finder],
  [data-platform-input], [data-product-url], [data-product-paste],
  [data-product-submit]/[data-product-submit-text], [data-paste-hint].
  Riêng [data-buy-flow] và .platform-tabs nằm ở dashboard.njk vì purchase.js
  tìm chúng bằng finder.closest("[data-buy-flow]") rồi querySelector trong đó.
#}
<section class="mb-converter shopping-panel" id="shop-search" aria-label="Tra cứu tiền hoàn">
  <header class="mb-converter-head">
    <div>
      <span class="mb-converter-icon" aria-hidden="true">{{ icon('discover') }}</span>
      <div>
        <h2>Khoan mua! Để Camio kiểm tra đã.</h2>
        <p>Dán link Shopee, TikTok Shop, Lazada — Camio tính tiền hoàn dự kiến cho bạn</p>
      </div>
    </div>
    <span class="mb-pill-note">Hoàn tiền tự động</span>
  </header>

  <form class="buy-form" data-product-finder novalidate>
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <input type="hidden" name="platform" value="{{ defaultPlatform }}" data-platform-input>
    <label class="buy-input-label" for="product-url">Link sản phẩm</label>
    {# Nhập/dán là MỘT nhóm (icon dán nằm trong ô nhập); Tra cứu là CTA
       chính đứng riêng bên phải. #}
    <div class="buy-input-row buy-input-row-emphasis">
      <div class="buy-input-field">
        <input
          id="product-url"
          type="url"
          name="productUrl"
          inputmode="url"
          autocomplete="off"
          maxlength="2048"
          placeholder="Dán link sản phẩm vào đây..."
          required
          aria-describedby="product-url-hint"
          data-product-url
        >
        <button type="button" class="buy-paste-button" data-product-paste hidden aria-label="Dán từ bộ nhớ tạm" title="Dán từ bộ nhớ tạm">{{ icon('paste') }}</button>
        <span class="buy-paste-mascot" data-paste-mascot aria-hidden="true"></span>
      </div>
      <button type="submit" data-product-submit><span data-product-submit-text>Tra cứu</span></button>
    </div>
    {# Câu thoại Camio đổi theo trạng thái (purchase.js cập nhật: chưa dán → đang soi → có/không hoàn → lỗi). #}
    <span class="buy-form-hint camio-line" id="product-url-hint" data-camio-line>Copy link → dán vào đây → xem hoàn tiền. Dễ thôi!</span>
    <small class="field-error" data-paste-hint hidden>Bộ nhớ tạm chưa có link nào, copy link rồi thử lại nha 👀</small>
  </form>

  {% include "app/dashboard/product-states.njk" %}
</section>
