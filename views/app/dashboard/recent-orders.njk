<section class="mb-panel" aria-label="Đơn hàng gần đây">
  <div class="mb-panel-head">
    <h2 class="mb-panel-title">Đơn hàng gần đây</h2>
    <a class="mb-see-all" href="/app/orders">Xem tất cả ›</a>
  </div>

  {% if recentOrders.length %}
    <div class="mb-orders">
      {% for order in recentOrders %}
        <a href="/app/support?orderId={{ order.platform_order_id }}&platform={{ order.platform }}" class="mb-order">
          <span class="mb-order-thumb">
            {% if order.product_image_url %}
              <img src="{{ order.product_image_url }}" alt="{{ order.product_name or order.platform_order_id }}" data-product-thumb>
            {% else %}
              <span class="platform-mark platform-{{ order.platform | lower }}">{{ order.platform | first }}</span>
            {% endif %}
          </span>
          <span class="mb-order-copy">
            <small>#{{ order.platform_order_id }} · {{ order.platform | lower }}</small>
            <b>{{ order.product_name or 'Đơn hàng Affiliate' }}</b>
            <em>{{ order.created_at | date }}</em>
          </span>
          <span class="mb-order-metrics">
            {% if order.cashback_rate_percent %}<i>+ {{ order.cashback_rate_percent }}%</i>{% endif %}
            <strong>+{{ order.cashback_vnd | vnd }}</strong>
          </span>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <p class="mb-empty-soft">Chưa có đơn nào. Dán link sản phẩm ở đầu trang để bắt đầu nhận hoàn tiền.</p>
  {% endif %}
</section>
