{% extends "app/app-base.njk" %}
{% from "partials/macros.njk" import empty_state %}

{% block app_content %}
  <section class="wallet-hero wallet-hero-wallet" aria-label="Số dư có thể rút">
    <div>
      <span>Có thể rút</span>
      <strong>{{ balances.available | vnd }}</strong>
      <small>Khoản đã được đối tác duyệt và chưa giữ cho lệnh rút.</small>
    </div>
    {% if balances.available > 0 %}
      <a class="button button-primary" href="/app/withdrawals">Rút tiền <span aria-hidden="true">→</span></a>
    {% else %}
      <a class="button" href="/app/withdrawals">Xem điều kiện rút tiền</a>
    {% endif %}
  </section>

  {# Dòng tiền hoàn trình bày theo tiến trình thay vì 3 card trắng lặp
     nhau: Đang chờ → Có thể rút → Đã nhận, mỗi bước một màu ngữ nghĩa. #}
  <section class="st-money-flow" aria-label="Dòng tiền hoàn">
    <article class="st-flow-step st-flow-wait">
      <span>Đang chờ đối soát</span>
      <strong>{{ balances.pending | vnd }}</strong>
      <small>Đơn chưa được sàn duyệt</small>
    </article>
    <i class="st-flow-arrow" aria-hidden="true">→</i>
    <article class="st-flow-step st-flow-ready">
      <span>Có thể rút</span>
      <strong>{{ balances.available | vnd }}</strong>
      <small>{% if balances.held > 0 %}Lệnh rút đang xử lý: {{ balances.held | vnd }}{% else %}Sẵn sàng tạo lệnh rút{% endif %}</small>
    </article>
    <i class="st-flow-arrow" aria-hidden="true">→</i>
    <article class="st-flow-step st-flow-paid">
      <span>Đã nhận</span>
      <strong>{{ balances.paid | vnd }}</strong>
      <small>Tổng đã chuyển vào ngân hàng</small>
    </article>
  </section>

  <section class="panel wallet-ledger-panel">
    <header class="panel-heading panel-heading-refined">
      <div>
        <span class="eyebrow">NHẬT KÝ</span>
        <h2>Lịch sử biến động</h2>
        <p>Mọi khoản cộng trừ đều được lưu để đối soát minh bạch.</p>
      </div>
    </header>
    {% if entries.length %}
      <div class="ledger-table-wrap">
        <div class="ledger-table-head" aria-hidden="true">
          <span>Loại</span>
          <span>Nội dung</span>
          <span>Số tiền</span>
        </div>
        <div class="ledger-list">
        {% for entry in entries %}
          <div class="ledger-row">
            <span class="ledger-icon {% if entry.direction == 'CREDIT' %}credit{% else %}debit{% endif %}">{% if entry.direction == 'CREDIT' %}+{% else %}−{% endif %}</span>
            <span><b>{{ entry.description }}</b><small>{{ entry.created_at | datetime }}</small></span>
            <strong class="{% if entry.direction == 'CREDIT' %}money-in{% else %}money-out{% endif %}">{% if entry.direction == 'CREDIT' %}+{% else %}−{% endif %}{{ entry.amount_vnd | vnd }}</strong>
          </div>
        {% endfor %}
        </div>
      </div>
    {% else %}
      {{ empty_state("💰 Ví đang chờ đồng đầu tiên.", "Lịch sử hiện khi đơn đầu tiên được ghi nhận hoặc khi bạn rút tiền. Bắt đầu bằng một link nhé!") }}
    {% endif %}
  </section>
{% endblock %}
