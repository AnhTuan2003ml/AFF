{% extends "app/app-base.njk" %}
{% from "partials/icons.njk" import icon %}
{% from "partials/macros.njk" import empty_state %}

{% macro order_tab(status, label) %}
  <a href="/app/orders?status={{ status }}{% if searchTerm %}&q={{ searchTerm }}{% endif %}" {% if selectedStatus == status %}class="active" aria-current="page"{% endif %}>{{ label }}</a>
{% endmacro %}

{% macro order_status(order) %}
  {% if order.status == 'AWAITING' %}
    <span class="orders-history-status is-pending">{{ icon('refresh') }} {{ t('Chờ sàn xác nhận', 'Awaiting platform') }}</span>
  {% elif order.status == 'UNTRACKED' %}
    <span class="orders-history-status is-cancelled">{{ icon('warning') }} {{ t('Không ghi nhận', 'Not tracked') }}</span>
  {% elif order.status == 'APPROVED' and order.cashback_released_at %}
    <span class="orders-history-status is-paid">{{ icon('orders') }} {{ t('Đã về ví', 'In wallet') }}</span>
  {% elif order.status == 'APPROVED' %}
    <span class="orders-history-status is-approved">{{ icon('orders') }} {{ t('Hoàn thành, chờ về ví', 'Done, pending payout') }}</span>
  {% elif order.status == 'PENDING' %}
    <span class="orders-history-status is-pending">{{ icon('orders') }} {{ t('Đang duyệt', 'Under review') }}</span>
  {% elif order.status == 'CANCELLED' %}
    <span class="orders-history-status is-cancelled">{{ icon('warning') }} {{ t('Đã hủy', 'Cancelled') }}</span>
  {% elif order.status in ['INVALID', 'REVERSED'] %}
    <span class="orders-history-status is-cancelled">{{ icon('warning') }} {{ t('Không hợp lệ', 'Invalid') }}</span>
  {% else %}
    <span class="orders-history-status is-pending">{{ order.status }}</span>
  {% endif %}
{% endmacro %}

{% block app_content %}
  <section class="orders-history-shell">
    <header class="orders-history-hero">
      <div class="orders-history-title">
        <span class="orders-history-icon" aria-hidden="true">{{ icon('orders') }}</span>
        <div>
          <h1>{{ t('Đơn hàng', 'Orders') }}</h1>
          <p>{{ orders.length }} {{ t('đơn trong bộ lọc hiện tại · mua qua liên kết ShopTik Affiliate', 'orders in current filter · bought via ShopTik Affiliate links') }}</p>
        </div>
      </div>

      <div class="orders-history-controls">
        {% if selectedStatus != 'VIEWED' %}
          <form class="orders-history-search" method="get" action="/app/orders">
            <input type="hidden" name="status" value="{{ selectedStatus }}">
            <label class="sr-only" for="orders-search-input">{{ t('Tìm đơn hàng theo mã đơn hoặc tên sản phẩm', 'Search orders by order code or product name') }}</label>
            <span aria-hidden="true">{{ icon('search') }}</span>
            <input id="orders-search-input" type="search" name="q" value="{{ searchTerm or '' }}" placeholder="{{ t('Tìm theo mã đơn, tên sản phẩm', 'Search by order code, product') }}" autocomplete="off">
          </form>
        {% endif %}

        <nav class="orders-history-tabs" aria-label="{{ t('Lọc trạng thái đơn', 'Filter by status') }}">
          {{ order_tab('ALL', t('Tất cả', 'All')) }}
          {{ order_tab('PENDING', t('Đang chờ', 'Pending')) }}
          {{ order_tab('APPROVED', t('Đã duyệt', 'Approved')) }}
          {{ order_tab('PAID', t('Đã về ví', 'In wallet')) }}
          {# "Sản phẩm đã xem" là một tab ngay tại đây (cạnh "Đã về ví") — hàng
             tab luôn hiện nên chuyển qua lại các lựa chọn không bị lạc trang. #}
          {{ order_tab('VIEWED', t('Sản phẩm đã xem', 'Viewed products')) }}
        </nav>
      </div>
    </header>

    {% if selectedStatus == 'VIEWED' %}
      {# Tab "Sản phẩm đã xem": các lượt đã bấm Mua ngay. Bọc [data-discover-page]
         để tái dùng discover.js cho nút "Mua lại" (đi đúng luồng affiliate). #}
      <div class="discover-page orders-viewed" data-discover-page>
        {% if viewedItems.length %}
          <section class="discover-grid" aria-label="Sản phẩm đã xem">
            {% for item in viewedItems %}
              <article class="discover-card discover-card-product">
                <div class="discover-card-media">
                  {% if item.productImageUrl %}
                    <img src="{{ item.productImageUrl }}" alt="{{ item.productName }}" loading="lazy" referrerpolicy="no-referrer">
                  {% else %}
                    <div class="discover-card-placeholder" aria-hidden="true"><span>▣</span></div>
                  {% endif %}
                  <div class="discover-card-badges">
                    <span class="discover-platform-badge platform-{{ item.platform | lower }}">
                      {% if item.platform == 'TIKTOK' %}TikTok{% elif item.platform == 'LAZADA' %}Lazada{% else %}Shopee{% endif %}
                    </span>
                  </div>
                </div>
                <div class="discover-card-body">
                  <div class="discover-card-meta"><time>{{ t('Đã xem', 'Viewed') }} {{ item.archivedAt | date }}</time></div>
                  <h2>{{ item.productName }}</h2>
                  {% if item.productPriceVnd %}
                    <div class="discover-price-box"><div><strong>{{ item.productPriceVnd | vnd }}</strong></div></div>
                  {% endif %}
                </div>
                <footer class="discover-card-footer">
                  {% if item.productUrl %}
                    <button class="discover-primary-action" type="button" data-discover-buy data-product-url="{{ item.productUrl }}"><b>{{ t('Mua lại', 'Buy again') }}</b><span aria-hidden="true">↗</span></button>
                  {% else %}
                    <span class="discover-static-action">{{ t('Không còn liên kết sản phẩm', 'Product link no longer available') }}</span>
                  {% endif %}
                </footer>
              </article>
            {% endfor %}
          </section>
        {% else %}
          <section class="orders-history-empty">
            {{ empty_state(t("🛒 Chiếc giỏ này đang hơi cô đơn…", "🛒 This cart is a little lonely…"), t("Bấm “Mua ngay” ở trang chủ, sản phẩm sẽ nằm đây để bạn xem và mua lại.", "Tap “Buy now” on the home page and products will appear here to review and rebuy."), "/app", t("Có link? Đưa Camio!", "Got a link? Give it to Camio!")) }}
          </section>
        {% endif %}
        <div class="discover-toast" role="status" aria-live="polite" data-discover-toast hidden></div>
      </div>
    {% elif orders.length %}
      <div class="orders-history-list">
        {% for order in orders %}
          <article class="orders-history-card">
            <div class="orders-history-product">
              <span class="orders-history-thumb">
                {% if order.product_image_url %}
                  <img src="{{ order.product_image_url }}" alt="{{ order.product_name or 'Sản phẩm' }}" loading="lazy">
                {% else %}
                  <span class="platform-mark platform-{{ order.platform | lower }}">{{ order.platform | first }}</span>
                {% endif %}
              </span>

              <div class="orders-history-info">
                <div class="orders-history-meta">
                  <span class="orders-history-platform platform-{{ order.platform | lower }}">{% if order.platform == 'TIKTOK' %}TikTok{% elif order.platform == 'LAZADA' %}Lazada{% else %}Shopee{% endif %}</span>
                  {{ order_status(order) }}
                  <span class="orders-history-code">{% if order.platform_order_id %}#{{ order.platform_order_id }}{% else %}{{ t('Chưa có mã đơn', 'No order code yet') }}{% endif %}</span>
                </div>

                {% if order.reference_code %}
                  <button type="button" class="orders-history-ref" data-copy-ref="{{ order.reference_code }}"
                    title="{{ t('Mã đối chiếu của ShopTik — dùng để đối chiếu với đơn trên sàn. Bấm để sao chép.', 'ShopTik reference code — used to reconcile with the platform order. Tap to copy.') }}">
                    <span>{{ t('Mã đối chiếu', 'Ref code') }}</span>
                    <code>{{ order.reference_code }}</code>
                    <i aria-hidden="true">⧉</i>
                  </button>
                {% endif %}

                <h2>{{ order.product_name or t('Sản phẩm đã mua', 'Purchased product') }}</h2>

                <div class="orders-history-dates">
                  <span>{{ (order.purchased_at or order.created_at) | date }}</span>
                  {% if order.status == 'AWAITING' %}
                    <i aria-hidden="true">•</i>
                    <span>{{ t('Sàn thường gửi dữ liệu sau vài giờ tới 24 giờ', 'Platforms usually send data within a few hours to 24h') }}</span>
                  {% elif order.status == 'UNTRACKED' %}
                    <i aria-hidden="true">•</i>
                    <span>{{ t('Sàn chưa ghi nhận đơn nào cho lượt mua này', 'The platform has not recorded any order for this click') }}</span>
                  {% elif order.status in ['CANCELLED', 'INVALID', 'REVERSED'] %}
                    {% if order.cancel_reason %}
                      <i aria-hidden="true">•</i>
                      <span>{{ t('Lý do', 'Reason') }}: <b>{{ order.cancel_reason }}</b></span>
                    {% endif %}
                  {% elif order.cashback_released_at %}
                    <i aria-hidden="true">•</i>
                    <span>{{ t('Đã về ví', 'In wallet') }}: <b>{{ order.cashback_released_at | date }}</b></span>
                  {% elif order.status == 'APPROVED' %}
                    <i aria-hidden="true">•</i>
                    <span>{{ t('Về ví', 'Payout') }}: <b>{{ order.estimated_payout_at | date }}</b>{% if order.hold_days_left %} ({{ t('còn', 'in') }} {{ order.hold_days_left }} {{ t('ngày', 'days') }}){% endif %}</span>
                  {% else %}
                    <i aria-hidden="true">•</i>
                    <span>{{ t('Dự kiến về ví', 'Est. payout') }}: <b>{{ (order.estimated_payout_at or order.purchased_at or order.created_at) | date }}</b></span>
                  {% endif %}
                </div>

                {% if order.product_price_vnd %}
                  <div class="orders-history-price">
                    {% if order.product_original_price_vnd %}<s>{{ order.product_original_price_vnd | vnd }}</s>{% endif %}
                    <b>{{ order.product_price_vnd | vnd }}</b>
                  </div>
                {% endif %}
              </div>
            </div>

            <aside class="orders-history-payout">
              <div>
                <small>{% if order.record_kind == 'INTENT' %}{{ t('Hoàn tiền dự kiến', 'Est. cashback') }}{% else %}{{ t('Hoàn tiền', 'Cashback') }}{% endif %}{% if order.cashback_rate_percent %} (+{{ order.cashback_rate_percent }}%){% endif %}</small>
                <strong>+{{ order.cashback_vnd | vnd }}</strong>
              </div>
              <a class="button button-small button-ghost" href="/app/support?platform={{ order.platform }}{% if order.platform_order_id %}&orderId={{ order.platform_order_id }}{% endif %}">{{ t('Hỗ trợ', 'Support') }}</a>
            </aside>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <section class="orders-history-empty">
        {{ empty_state(t("Camio chưa thấy đơn nào 👀", "Camio sees no orders yet 👀"), t("Đổi bộ lọc thử, hoặc dán một chiếc link và bắt đầu thôi 🧡", "Try another filter, or paste a link to get started 🧡"), "/app", t("Đi săn hoàn thôi", "Start earning cashback")) }}
      </section>
    {% endif %}
  </section>
{% endblock %}

{% block page_scripts %}
  {# discover.css/js phục vụ tab "Sản phẩm đã xem" (thẻ + nút "Mua lại").
     discover.js tự thoát nếu không có [data-discover-page] nên tab khác vô hại. #}
  <script src="/assets/discover.js?v={{ assetVersion }}" defer></script>
  <script src="/assets/orders.js?v={{ assetVersion }}" defer></script>
{% endblock %}
