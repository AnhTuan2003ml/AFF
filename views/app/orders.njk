{% extends "app/app-base.njk" %}
{% from "partials/icons.njk" import icon %}
{% from "partials/macros.njk" import empty_state %}

{% macro order_tab(status, label) %}
  <a href="/app/orders?status={{ status }}{% if searchTerm %}&q={{ searchTerm }}{% endif %}" {% if selectedStatus == status %}class="active" aria-current="page"{% endif %}>{{ label }}</a>
{% endmacro %}

{% macro order_status(order) %}
  {% if order.status == 'AWAITING' %}
    <span class="orders-history-status is-pending">{{ icon('refresh') }} Chờ sàn xác nhận</span>
  {% elif order.status == 'UNTRACKED' %}
    <span class="orders-history-status is-cancelled">{{ icon('warning') }} Không ghi nhận</span>
  {% elif order.status == 'APPROVED' and order.cashback_released_at %}
    <span class="orders-history-status is-paid">{{ icon('orders') }} Đã về ví</span>
  {% elif order.status == 'APPROVED' %}
    <span class="orders-history-status is-approved">{{ icon('orders') }} Hoàn thành, chờ về ví</span>
  {% elif order.status == 'PENDING' %}
    <span class="orders-history-status is-pending">{{ icon('orders') }} Đang duyệt</span>
  {% elif order.status == 'CANCELLED' %}
    <span class="orders-history-status is-cancelled">{{ icon('warning') }} Đã hủy</span>
  {% elif order.status in ['INVALID', 'REVERSED'] %}
    <span class="orders-history-status is-cancelled">{{ icon('warning') }} Không hợp lệ</span>
  {% else %}
    <span class="orders-history-status is-pending">{{ order.status }}</span>
  {% endif %}
{% endmacro %}

{% block app_content %}
  <section class="orders-history-shell">
    <header class="orders-history-hero">
      <div class="orders-history-title">
        <span class="orders-history-icon">{{ icon('orders') }}</span>
        <div>
          <h1>Đơn hàng</h1>
          <p>{{ orders.length }} đơn trong bộ lọc hiện tại · mua qua liên kết ShopTik Affiliate</p>
        </div>
      </div>

      <div class="orders-history-controls">
        <form class="orders-history-search" method="get" action="/app/orders">
          <input type="hidden" name="status" value="{{ selectedStatus }}">
          <label class="sr-only" for="orders-search-input">Tìm đơn hàng theo mã đơn hoặc tên sản phẩm</label>
          <span aria-hidden="true">{{ icon('search') }}</span>
          <input id="orders-search-input" type="search" name="q" value="{{ searchTerm or '' }}" placeholder="Tìm theo mã đơn, tên sản phẩm" autocomplete="off">
        </form>

        <nav class="orders-history-tabs" aria-label="Lọc trạng thái đơn">
          {{ order_tab('ALL', 'Tất cả') }}
          {{ order_tab('PENDING', 'Đang chờ') }}
          {{ order_tab('APPROVED', 'Đã duyệt') }}
          {{ order_tab('PAID', 'Đã về ví') }}
        </nav>
      </div>
    </header>

    {% if orders.length %}
      <div class="orders-history-list">
        {% for order in orders %}
          <article class="orders-history-card">
            <div class="orders-history-product">
              <span class="orders-history-thumb">
                {% if order.product_image_url %}
                  <img src="{{ order.product_image_url }}" alt="{{ order.product_name or 'Sản phẩm' }}" loading="lazy">
                {% else %}
                  <span class="platform-mark platform-{{ order.platform | lower }}">{{ order.platform | first }}</span>
                {% endif %}
              </span>

              <div class="orders-history-info">
                <div class="orders-history-meta">
                  <span class="orders-history-code">{% if order.platform_order_id %}#{{ order.platform_order_id }}{% else %}Chưa có mã đơn{% endif %}</span>
                  <span class="orders-history-platform">{% if order.platform == 'TIKTOK' %}TikTok{% elseif order.platform == 'LAZADA' %}Lazada{% else %}Shopee{% endif %}</span>
                </div>

                <h2>{{ order.product_name or "Sản phẩm đã mua" }}</h2>

                <div class="orders-history-dates">
                  <span>{{ (order.purchased_at or order.created_at) | date }}</span>
                  {% if order.status == 'AWAITING' %}
                    <i aria-hidden="true">•</i>
                    <span>Sàn thường gửi dữ liệu sau vài giờ tới 24 giờ</span>
                  {% elif order.status == 'UNTRACKED' %}
                    <i aria-hidden="true">•</i>
                    <span>Sàn chưa ghi nhận đơn nào cho lượt mua này</span>
                  {% elif order.status in ['CANCELLED', 'INVALID', 'REVERSED'] %}
                    {% if order.cancel_reason %}
                      <i aria-hidden="true">•</i>
                      <span>Lý do: <b>{{ order.cancel_reason }}</b></span>
                    {% endif %}
                  {% elif order.cashback_released_at %}
                    <i aria-hidden="true">•</i>
                    <span>Đã về ví: <b>{{ order.cashback_released_at | date }}</b></span>
                  {% elif order.status == 'APPROVED' %}
                    <i aria-hidden="true">•</i>
                    <span>Về ví: <b>{{ order.estimated_payout_at | date }}</b>{% if order.hold_days_left %} (còn {{ order.hold_days_left }} ngày){% endif %}</span>
                  {% else %}
                    <i aria-hidden="true">•</i>
                    <span>Dự kiến về ví: <b>{{ (order.estimated_payout_at or order.purchased_at or order.created_at) | date }}</b></span>
                  {% endif %}
                </div>

                {% if order.product_price_vnd %}
                  <div class="orders-history-price">
                    {% if order.product_original_price_vnd %}<s>{{ order.product_original_price_vnd | vnd }}</s>{% endif %}
                    <b>{{ order.product_price_vnd | vnd }}</b>
                  </div>
                {% endif %}
              </div>
            </div>

            <aside class="orders-history-payout">
              {{ order_status(order) }}
              <div>
                <small>{% if order.record_kind == 'INTENT' %}Hoàn tiền dự kiến{% else %}Hoàn tiền{% endif %}{% if order.cashback_rate_percent %} (+{{ order.cashback_rate_percent }}%){% endif %}</small>
                <strong>+{{ order.cashback_vnd | vnd }}</strong>
              </div>
              <a class="button button-small button-ghost" href="/app/support?platform={{ order.platform }}{% if order.platform_order_id %}&orderId={{ order.platform_order_id }}{% endif %}">Hỗ trợ</a>
            </aside>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <section class="orders-history-empty">
        {{ empty_state("Không tìm thấy đơn hàng nào", "Hãy thử đổi bộ lọc hoặc tìm sản phẩm mới để ghi nhận đơn hoàn tiền.", "/app", "Tìm sản phẩm") }}
      </section>
    {% endif %}
  </section>
{% endblock %}
