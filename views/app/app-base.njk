{% extends "base.njk" %}
{% from "partials/icons.njk" import icon %}

{% block body %}
  <script src="/assets/support-chat.js?v={{ assetVersion }}" defer></script>
  <link rel="stylesheet" href="/assets/blob-mascot.css?v={{ assetVersion }}">
  <script src="/assets/blob-mascot.js?v={{ assetVersion }}" defer></script>
  <script src="/assets/blob-logout.js?v={{ assetVersion }}" defer></script>
  <script src="/assets/blob-notify.js?v={{ assetVersion }}" defer></script>
  <script src="/assets/blob-fab.js?v={{ assetVersion }}" defer></script>
  <script src="/assets/blob-welcome.js?v={{ assetVersion }}" defer></script>

  {% set persistentBalances = headerBalances or balances %}
  {% set navItems = [
    { href: '/app', section: 'dashboard', label: 'Trang chủ' },
    { href: '/app/discover', section: 'discover', label: 'Khám phá' },
    { href: '/app/orders', section: 'orders', label: 'Đơn hàng' },
    { href: '/app/wallet', section: 'wallet', label: 'Ví' },
    { href: '/app/nhiem-vu', section: 'missions', label: 'Nhiệm vụ' },
    { href: '/app/links', section: 'links', label: 'Chia sẻ' },
    { href: '/app/referrals', section: 'referrals', label: 'Giới thiệu' },
    { href: '/app/support', section: 'support', label: 'Hỗ trợ' }
  ] %}
  {% set financeSections = ['wallet', 'withdrawals', 'banks'] %}

  <div class="px-app st-app app-section-{{ appSection or 'default' }}" data-app-section="{{ appSection or 'default' }}">
    <header class="px-header">
      <div class="px-header-inner">
        <a class="px-menu-shortcut" href="/app/settings" aria-label="Tất cả chức năng">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </a>

        <a class="px-brand" href="/app" aria-label="ShopTik - Trang chủ">
          <img src="/assets/images/icon.png?v={{ assetVersion }}" alt="" aria-hidden="true">
          <span>ShopTik</span>
        </a>

        <nav class="px-desktop-nav" aria-label="Điều hướng chính">
          {% for item in navItems %}
            {% set isActive = (item.section == appSection) or (item.section == 'wallet' and appSection in financeSections) %}
            <a href="{{ item.href }}"{% if isActive %} class="active" aria-current="page"{% endif %}>{{ item.label }}</a>
          {% endfor %}
        </nav>

        <div class="px-header-actions">
          <a class="px-head-icon" href="/app/discover" aria-label="Tìm kiếm">{{ icon('search') }}</a>

          <div class="notification-menu">
            {% set notifBase = unreadNotificationCount or 0 %}
            {% set badgeTotal = notifBase + (unreadSupportCount or 0) %}
            <button type="button" class="px-head-icon notification-trigger" data-notification-trigger aria-expanded="false" aria-label="Thông báo">
              {{ icon('bell') }}
              <b class="notification-badge" data-notification-badge data-notif-base="{{ notifBase }}"{% if not badgeTotal %} hidden{% endif %}>{{ badgeTotal if badgeTotal <= 9 else '9+' }}</b>
            </button>
            <div class="notification-dropdown" data-notification-panel>
              <div class="notification-dropdown-head"><b>Thông báo</b></div>
              {% if unreadSupportCount %}
                <a class="notification-support-item" href="/app/support" data-support-notice>
                  <b>Đội ngũ chăm sóc đã phản hồi</b>
                  <p>{{ unreadSupportCount }} tin nhắn mới từ hỗ trợ. Bấm để mở.</p>
                </a>
              {% endif %}
              {% if recentNotifications and recentNotifications.length %}
                <ul class="notification-list">
                  {% for item in recentNotifications %}
                    <li class="{{ 'unread' if not item.isRead }}">
                      <b>{{ item.title }}</b>
                      {% if item.body %}<p>{{ item.body }}</p>{% endif %}
                      <time>{{ item.createdAt | datetime }}</time>
                    </li>
                  {% endfor %}
                </ul>
              {% elif not unreadSupportCount %}
                <p class="notification-empty">Bạn chưa có thông báo mới.</p>
              {% endif %}
            </div>
          </div>

          <a class="px-head-icon px-wallet-link" href="/app/wallet" aria-label="Ví">
            {{ icon('wallet') }}
            {% if persistentBalances %}<span>{{ persistentBalances.available | vnd }}</span>{% endif %}
          </a>

          <div class="st-menu px-account-menu">
            <button type="button" class="px-account-trigger st-account" data-menu-trigger aria-haspopup="true" aria-expanded="false" title="{{ currentUser.email }}">
              <span class="st-avatar" aria-hidden="true">{% if currentUser.avatarUrl %}<img src="{{ currentUser.avatarUrl }}" alt="" referrerpolicy="no-referrer">{% else %}{{ (currentUser.fullName or currentUser.email or '?') | first | upper }}{% endif %}</span>
              <span class="px-account-name">{{ currentUser.fullName or 'Tài khoản' }}</span>
              {{ icon('chevron-down') }}
            </button>
            <div class="st-menu-panel" data-menu>
              <a href="/app/profile">{{ icon('user') }}<span>Thông tin cá nhân</span></a>
              <a href="/app/settings">{{ icon('settings') }}<span>Tất cả chức năng</span></a>
              <a href="/app/banks">{{ icon('bank') }}<span>Tài khoản ngân hàng</span></a>
              <a href="/app/links">{{ icon('link') }}<span>Link chia sẻ</span></a>
              {% if currentUser.role != 'USER' %}<a href="/backoffice/console">{{ icon('ops') }}<span>Trang quản trị</span></a>{% endif %}
              <div class="st-menu-divider" role="separator"></div>
              <form method="post" action="/dang-xuat">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <button class="st-menu-logout button-ghost" type="submit">{{ icon('logout') }}<span>Đăng xuất</span></button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main class="st-content px-main" id="main-content" tabindex="-1">
      {% include "partials/flash.njk" %}
      {% if appSection in financeSections %}
        <section class="px-page-intro">
          <span class="px-eyebrow">TÀI CHÍNH</span>
          <h1>Tiền hoàn của bạn.</h1>
          <p>Theo dõi số dư, tạo lệnh rút và quản lý tài khoản nhận tiền trong một nơi.</p>
        </section>
        <nav class="st-subtabs px-subtabs" aria-label="Khu vực tài chính">
          <a href="/app/wallet" {% if appSection == 'wallet' %}class="active" aria-current="page"{% endif %}>Số dư</a>
          <a href="/app/withdrawals" {% if appSection == 'withdrawals' %}class="active" aria-current="page"{% endif %}>Rút tiền</a>
          <a href="/app/banks" {% if appSection == 'banks' %}class="active" aria-current="page"{% endif %}>Ngân hàng</a>
        </nav>
      {% endif %}
      {% block app_content %}{% endblock %}
    </main>

    <footer class="px-footer">
      <div class="px-footer-top">
        <div class="px-footer-brand">
          <a href="/app"><img src="/assets/images/icon.png?v={{ assetVersion }}" alt=""><strong>ShopTik</strong></a>
          <p>Một trải nghiệm mua sắm gọn hơn: kiểm tra hoàn tiền, mua qua liên kết và theo dõi ví minh bạch.</p>
        </div>
        <div class="px-footer-col"><b>Mua sắm</b><a href="/app">Dán link sản phẩm</a><a href="/app/discover">Khám phá ưu đãi</a><a href="/app/orders">Đơn hàng</a></div>
        <div class="px-footer-col"><b>Tài khoản</b><a href="/app/wallet">Ví hoàn tiền</a><a href="/app/banks">Ngân hàng</a><a href="/app/profile">Hồ sơ</a></div>
        <div class="px-footer-col"><b>Hỗ trợ</b><a href="/app/support">Trung tâm hỗ trợ</a><a href="/chinh-sach-nguoi-dung" data-user-policy-link>Chính sách</a><a href="/dieu-khoan">Điều khoản</a></div>
      </div>

      <div class="px-footer-apps">
        <div class="px-footer-apps-copy">
          <b>Tải ứng dụng ShopTik</b>
          <small>Theo dõi đơn và nhận tiền hoàn ngay trên điện thoại.</small>
        </div>
        <div class="px-stores">
          <span class="px-store" role="img" aria-label="App Store — sắp ra mắt">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.4 12.7c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.7-1.3-.1-2.5.8-3.1.8s-1.6-.7-2.7-.7c-1.4 0-2.7.8-3.4 2-1.4 2.5-.4 6.2 1 8.2.7 1 1.5 2.1 2.6 2.1 1 0 1.4-.7 2.7-.7s1.6.7 2.7.6c1.1 0 1.8-1 2.5-2 .8-1.1 1.1-2.2 1.1-2.3 0 0-2.2-.8-2.2-3.1z"/><path d="M14.6 6.3c.6-.7 1-1.6.9-2.6-.8 0-1.9.6-2.5 1.3-.5.6-1 1.6-.9 2.5.9.1 1.8-.5 2.5-1.2z"/></svg>
            <span><small>Tải về trên</small><b>App Store</b></span>
          </span>
          <span class="px-store" role="img" aria-label="Google Play — sắp ra mắt">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3.2v17.6c0 .5.5.8.9.6l9.6-5.6-2.6-2.6z"/><path d="M4 3.2 11.9 11l2.6-2.6L4.9 2.6c-.4-.2-.9.1-.9.6z"/><path d="m17.6 9.9-3.1-1.5L11.9 11l2.6 2.6 3.1-1.8c.6-.4.6-1.5 0-1.9z"/></svg>
            <span><small>Tải về trên</small><b>Google Play</b></span>
          </span>
          <span class="px-store-soon">Sắp ra mắt</span>
        </div>
      </div>

      <div class="px-footer-bottom"><span>© 2026 ShopTik</span><span>Shopee · TikTok Shop · Lazada</span></div>
    </footer>

    <nav class="mb-bottomnav px-bottomnav" aria-label="Điều hướng di động">
      <a href="/app" {% if appSection == 'dashboard' %}class="active" aria-current="page"{% endif %}>{{ icon('discover') }}<b>Trang chủ</b></a>
      <a href="/app/discover" {% if appSection == 'discover' %}class="active" aria-current="page"{% endif %}>{{ icon('compass') }}<b>Khám phá</b></a>
      <a href="/app/orders" {% if appSection == 'orders' %}class="active" aria-current="page"{% endif %}>{{ icon('orders') }}<b>Đơn hàng</b></a>
      <a href="/app/wallet" {% if appSection in financeSections %}class="active" aria-current="page"{% endif %}>{{ icon('wallet') }}<b>Ví</b></a>
      <a href="/app/settings" {% if appSection in ['settings', 'profile'] %}class="active" aria-current="page"{% endif %}>{{ icon('user') }}<b>Tài khoản</b></a>
    </nav>

    <a class="st-support-fab" href="/app/support" aria-label="Chăm sóc khách hàng">
      <span class="st-fab-mascot" data-fab-mascot aria-hidden="true"></span><span class="st-fab-label">Hỗ trợ</span>
    </a>

    {# Modal xác nhận có linh vật — dùng chung cho đăng xuất và các thao tác
       nhạy cảm (form gắn data-blob-confirm). #}
    <div class="blob-modal-scrim" data-confirm-modal hidden inert>
      <div class="blob-modal" role="dialog" aria-modal="true" aria-labelledby="blob-confirm-title">
        <button class="blob-modal-close" type="button" data-confirm-cancel aria-label="Đóng">×</button>
        <div class="blob-modal-mascot" data-confirm-mascot></div>
        <span class="blob-modal-eyebrow" data-confirm-eyebrow>Sắp đi đâu à?</span>
        <h2 id="blob-confirm-title" data-confirm-title>Đăng xuất?</h2>
        <p class="blob-modal-copy" data-confirm-copy>Bạn sẽ cần đăng nhập lại để vào tài khoản.</p>
        <div class="blob-modal-actions">
          <button class="blob-btn-stay" type="button" data-confirm-cancel>Ở lại</button>
          <button class="blob-btn-out" type="button" data-confirm-ok>Đăng xuất</button>
        </div>
      </div>
    </div>

    {# Linh vật góc màn hình: thông báo / CSKH phản hồi #}
    <div class="blob-toast" data-blob-toast hidden role="status" aria-live="polite"
      data-support-unread="{{ unreadSupportCount or 0 }}"
      data-on-support="{{ 'yes' if appSection == 'support' else '' }}"></div>

    {# Vừa đăng nhập: linh vật đi từ mép phải ra giữa chào mừng (một lần) #}
    {% if welcomeBack %}<div data-camio-welcome data-welcome-name="{{ currentUser.fullName or '' }}" hidden></div>{% endif %}

    <div class="entry-promo-scrim" data-entry-promo hidden inert>
      <section class="entry-promo-modal" role="dialog" aria-modal="true" aria-labelledby="entry-promo-title-copy">
        <div class="entry-promo-scroll">
          <div class="entry-promo-card">
            <a class="entry-promo-visual" href="#" data-entry-promo-image-link target="_blank" rel="noopener noreferrer" hidden><img src="" alt="" data-entry-promo-image hidden></a>
            <div class="entry-promo-visual" data-entry-promo-visual-static hidden><img src="" alt="" data-entry-promo-image-static hidden></div>
            <div class="entry-promo-placeholder" data-entry-promo-placeholder hidden><span data-entry-promo-badge hidden></span><strong data-entry-promo-type></strong><h2 id="entry-promo-title" data-entry-promo-title>Ưu đãi mới từ ShopTik</h2><p data-entry-promo-description>Khám phá nội dung vừa được quản trị đăng lên.</p></div>
            <div class="entry-promo-body"><div class="entry-promo-copy"><span class="entry-promo-chip" data-entry-promo-type-label hidden></span><b data-entry-promo-badge-inline hidden></b><h2 id="entry-promo-title-copy" data-entry-promo-title-copy></h2><p data-entry-promo-description-copy></p></div><a class="button button-primary entry-promo-cta" href="#" data-entry-promo-cta target="_blank" rel="noopener noreferrer" hidden>Xem chi tiết</a></div>
            <div class="entry-promo-closebar"><button class="entry-promo-close" type="button" data-entry-promo-close aria-label="Đóng quảng cáo">×</button></div>
          </div>
        </div>
      </section>
    </div>
  </div>
  <script src="/assets/app-entry-promo.js?v={{ assetVersion }}" defer></script>
{% endblock %}
