{% extends "app/app-base.njk" %}
{% from "partials/icons.njk" import icon %}

{% block page_scripts %}
  <script src="/assets/discover.js?v={{ assetVersion }}" defer></script>
  <script src="/assets/discover-bestsellers.js?v={{ assetVersion }}" defer></script>
{% endblock %}

{% block app_content %}
  <div class="discover-page px-discover" data-discover-page>
    <section class="px-discover-hero" aria-labelledby="discover-title">
      <div>
        <span class="px-eyebrow">SHOPPING DISCOVERY</span>
        <h1 id="discover-title">Sản phẩm đáng để khám phá.</h1>
        <p>Duyệt sản phẩm, so sánh mức hoàn và đi thẳng đến sàn bạn muốn mua.</p>
      </div>
      {% if maxCashbackRate > 0 %}<span class="px-rate-pill">Hoàn đến {{ maxCashbackRate }}%</span>{% endif %}
    </section>

    {% if items.length %}
      <section class="discover-filters px-discover-filters" aria-label="Tìm kiếm và lọc nội dung">
        <label class="discover-search px-discover-search">
          <span aria-hidden="true">{{ icon('search') }}</span>
          <span class="sr-only">Tìm nội dung</span>
          <input type="search" placeholder="Tìm sản phẩm, thương hiệu hoặc voucher" autocomplete="off" data-discover-search>
        </label>

        <div class="discover-filter-buttons">
          {# Cấp 1 — CHỌN SÀN. Vào mặc định Shopee. #}
          <div class="discover-platform-switch" role="group" aria-label="Chọn sàn" data-platform-switch>
            <button type="button" class="active platform-shopee" data-platform-select="shopee" aria-pressed="true">Shopee</button>
            <button type="button" class="platform-lazada" data-platform-select="lazada" aria-pressed="false">Lazada</button>
          </div>

          {# Cấp 2a — Hạng mục Shopee #}
          <div class="discover-category-tabs px-filter-tabs px-category-tabs" role="group" aria-label="Danh mục Shopee" data-platform-cats="shopee">
            <button type="button" class="active" data-discover-category="all" aria-pressed="true">Tất cả</button>
            <button type="button" class="discover-tab-hot" data-discover-livelist="hot" aria-pressed="false">🔥 Hot</button>
            <button type="button" class="discover-tab-voucher" data-discover-voucher aria-pressed="false">🎟️ Voucher</button>
            <button type="button" data-discover-livelist="recommend" aria-pressed="false">Đề xuất</button>
            <button type="button" data-discover-livelist="best" aria-pressed="false">Bán chạy</button>
            <button type="button" data-discover-livelist="exclusive" aria-pressed="false">Độc quyền</button>
            {% for category in categories %}<button type="button" data-discover-category="{{ category }}" aria-pressed="false">{{ category }}</button>{% endfor %}
          </div>

          {# Cấp 2b — Hạng mục Lazada (feed affiliate; ẩn tới khi chọn Lazada) #}
          <div class="discover-category-tabs px-filter-tabs px-category-tabs" role="group" aria-label="Danh mục Lazada" data-platform-cats="lazada" hidden>
            <button type="button" class="active" data-discover-livelist="recommend" aria-pressed="true">Đề xuất</button>
            <button type="button" class="discover-tab-hot" data-discover-livelist="hot" aria-pressed="false">🔥 Hoa hồng cao</button>
            <button type="button" data-discover-livelist="best" aria-pressed="false">Bán chạy</button>
          </div>
        </div>
      </section>

      <section class="discover-grid px-product-grid" aria-live="polite" data-discover-grid>
        {% for item in items %}
          <article class="discover-card discover-card-{{ item.typeKey }} px-product-card" data-discover-card data-platform="{{ item.platform }}" data-category="{{ item.category }}">
            <div class="discover-card-media px-product-media">
              <img src="{{ item.image_url if item.image_url else '/assets/images/icon.png' }}" alt="{{ item.title }}" loading="lazy" referrerpolicy="no-referrer" data-discover-image onerror="if(!this.src.endsWith('/assets/images/icon.png')){this.src='/assets/images/icon.png';this.classList.add('is-placeholder');}">
              <div class="discover-card-badges">
                {% if item.platformName %}<span class="discover-platform-badge platform-{{ item.platform }}">{{ item.platformName }}</span>{% endif %}
                {% if item.isProduct and item.cashbackRate is not none and item.cashbackRate > 0 %}<span class="discover-cashback-badge">+{{ item.cashbackRate }}%</span>{% endif %}
              </div>
            </div>
            <div class="discover-card-body px-product-body">
              {% if item.category %}<span class="px-product-category">{{ item.category }}</span>{% endif %}
              <h2>{{ item.title }}</h2>
              {% if item.isProduct %}
                <div class="discover-price-box px-price-box">
                  <div><strong>{% if item.salePrice is not none %}{{ item.salePrice | vnd }}{% else %}Xem giá trên sàn{% endif %}</strong>{% if item.originalPrice is not none %}<del>{{ item.originalPrice | vnd }}</del>{% endif %}</div>
                  <p><span>Hoàn về ví</span><b>{% if item.cashbackAmount is not none %}+{{ item.cashbackAmount | vnd }}{% else %}Kiểm tra khi mua{% endif %}</b></p>
                </div>
              {% elif item.description %}<p class="discover-card-description">{{ item.description }}</p>{% endif %}
            </div>
            <footer class="discover-card-footer px-product-footer">
              {% if item.isProduct and item.target_url %}<button class="discover-primary-action" type="button" data-discover-buy data-product-url="{{ item.target_url }}"><b data-buy-label>Mua qua ShopTik</b><span aria-hidden="true">→</span></button>
              {% elif item.target_url %}<a class="discover-primary-action" href="{{ item.target_url }}" target="_blank" rel="noopener noreferrer"><b>Xem chi tiết</b><span aria-hidden="true">→</span></a>
              {% else %}<span class="discover-static-action">Thông tin</span>{% endif %}
            </footer>
          </article>
        {% endfor %}
      </section>

      <section class="discover-filter-empty" data-discover-filter-empty hidden><h2>Không tìm thấy sản phẩm phù hợp.</h2><p>Thử đổi từ khóa, sàn hoặc danh mục.</p></section>
    {% else %}
      <section class="discover-database-empty"><h2>Chưa có nội dung để khám phá.</h2><p>Sản phẩm mới sẽ xuất hiện tại đây khi dữ liệu được cập nhật.</p></section>
    {% endif %}

    <section class="bestseller-section" data-bestseller data-endpoint="/app/discover/offer-products" data-endpoint-lazada="/app/discover/lazada-offers" hidden aria-labelledby="bestseller-title">
      <header class="px-section-head bestseller-head"><div><span class="px-eyebrow">LIVE CATALOG</span><h2 id="bestseller-title" data-bestseller-title>Bán chạy nhất trên Shopee.</h2></div><p>Mỗi trang 20 sản phẩm. Mua qua ShopTik để nhận hoàn tiền.</p></header>
      <div class="discover-grid px-product-grid" data-bestseller-grid aria-live="polite"></div>
      <div class="bestseller-loading" data-bestseller-loading hidden aria-hidden="true"><span class="bestseller-spinner"></span></div>
      <p class="bestseller-status" data-bestseller-status hidden></p>
      <nav class="bestseller-pagination" data-bestseller-pagination aria-label="Chuyển trang" hidden></nav>
    </section>

    {# ── Tab Voucher: mã giảm giá theo sàn (Shopee có; Lazada đang cập nhật) ── #}
    <section class="voucher-section" data-voucher-section hidden aria-label="Voucher hôm nay">
      <header class="px-section-head"><div><span class="px-eyebrow">MÃ GIẢM GIÁ SHOPEE</span><h2>🎟️ Voucher hôm nay</h2></div><p>Bấm “Dùng ngay” để lưu mã và đi thẳng đến Shopee.</p></header>
      <div class="voucher-grid" data-voucher-grid aria-live="polite"></div>
      <p class="bestseller-status" data-voucher-status hidden></p>
    </section>

    <div class="discover-toast" role="status" aria-live="polite" data-discover-toast hidden></div>
  </div>
  <script src="/assets/discover-vouchers.js?v={{ assetVersion }}" defer></script>
{% endblock %}
