{% extends "app/app-base.njk" %}
{% from "partials/macros.njk" import status_badge, empty_state %}

{% block app_content %}
  <section class="page-heading">
    <div>
      <span class="eyebrow">CHỈ DÙNG KHI NHẬN TIỀN</span>
      <h1>Tài khoản ngân hàng</h1>
      <p>Thông tin được mã hóa; giao diện và nhật ký chỉ hiển thị 4 số cuối.</p>
    </div>
  </section>

  <div class="two-column-layout bank-task-layout">
    <section class="panel bank-create-panel">
      <header class="panel-heading"><div><span class="eyebrow">THÊM MỚI</span><h2>Tài khoản nhận tiền</h2></div></header>
      <form method="post" action="/app/banks/request" class="stack-form" data-validate-form novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <label for="bank-code-input">Ngân hàng
          <select id="bank-code-input" name="bankCode" required data-required-message="Vui lòng chọn ngân hàng.">
            <option value="">Chọn ngân hàng</option>
            {% for bank in banks %}<option value="{{ bank.code }}">{{ bank.name }} ({{ bank.code }})</option>{% endfor %}
          </select>
          <small class="field-error" id="bank-code-input-error" hidden></small>
        </label>
        <label for="account-number-input">Số tài khoản
          <input id="account-number-input" type="text" name="accountNumber" inputmode="numeric" autocomplete="off" pattern="[0-9]{6,20}" maxlength="20" placeholder="Chỉ nhập số" required data-required-message="Vui lòng nhập số tài khoản." data-pattern-message="Số tài khoản chỉ gồm 6-20 chữ số.">
          <small class="field-error" id="account-number-input-error" hidden></small>
        </label>
        <label for="account-name-input">Tên chủ tài khoản
          <input id="account-name-input" class="account-name-input" type="text" name="accountName" autocomplete="off" minlength="3" maxlength="100" placeholder="NGUYEN VAN A" required data-required-message="Vui lòng nhập tên chủ tài khoản." data-minlength-message="Tên chủ tài khoản cần ít nhất 3 ký tự.">
          <small>Nhập đúng tên hiển thị tại ngân hàng — hệ thống sẽ tự chuẩn hóa thành chữ in hoa.</small>
          <small class="field-error" id="account-name-input-error" hidden></small>
        </label>
        <button class="button button-primary button-block" type="submit" data-submit-button>Gửi OTP xác nhận</button>
      </form>
      <div class="security-note"><span>⌾</span><p>ShopTik không cần và không bao giờ hỏi mật khẩu, PIN hoặc OTP Internet Banking.</p></div>
    </section>

    <section class="panel bank-list-panel">
      <header class="panel-heading"><div><span class="eyebrow">TÀI KHOẢN ĐÃ THÊM</span><h2>Danh sách nhận tiền</h2></div></header>
      {% if accounts.length %}
        <div class="bank-visual-list">
          {% for account in accounts %}
            <article class="bank-visual-card {% if account.status == 'VERIFIED' %}is-verified{% endif %}">
              <header>
                <span class="bank-visual-name">{{ account.bank_code }}</span>
                {{ status_badge(account.status) }}
              </header>
              <span class="bank-visual-chip" aria-hidden="true"></span>
              <p class="bank-visual-number" aria-label="Số tài khoản đã che">
                xxxx&nbsp;xxxx&nbsp;x{{ account.account_last4.slice(1) }}
              </p>
              <footer>
                <span><small>CHỦ TÀI KHOẢN</small><b>{{ account.account_name_full }}</b></span>
                <span><small>NGÀY THÊM</small><b>{{ account.created_at | date }}</b></span>
              </footer>
              {% if account.rejection_reason %}<p class="bank-reason">{{ account.rejection_reason }}</p>{% endif %}
            </article>
          {% endfor %}
        </div>
        <p class="bank-review-note">Xác nhận OTP xong là tài khoản dùng được ngay để rút tiền.</p>
      {% else %}
        {{ empty_state("Chưa có tài khoản ngân hàng", "Thêm tài khoản khi bạn chuẩn bị rút tiền.") }}
      {% endif %}
    </section>
  </div>
{% endblock %}
