{% extends "app/app-base.njk" %}

{% block app_content %}
  <link rel="stylesheet" href="/assets/support-chat.css?v={{ assetVersion }}">

  <section class="page-heading">
    <div>
      <h1>Hỗ trợ</h1>
      <p>Chat trực tiếp với đội chăm sóc khách hàng.</p>
    </div>
  </section>

  <section class="panel support-chat-panel" data-chat
    data-endpoint="/app/support/messages" data-csrf="{{ csrfToken }}">
    <header class="support-chat-head">
      <div class="support-chat-status">
        <span class="support-chat-dot {% if chatOnline %}is-online{% endif %}" aria-hidden="true"></span>
        <span>{% if chatOnline %}Đội CSKH đang trực — phản hồi sớm nhất có thể{% else %}Kênh chat đang bảo trì — tin nhắn vẫn được lưu lại{% endif %}</span>
      </div>
    </header>

    <div class="support-chat-messages" data-chat-messages tabindex="0"
      role="log" aria-label="Lịch sử trò chuyện" aria-live="polite">
      <div class="support-chat-empty" data-chat-empty {% if messages.length %}hidden{% endif %}>
        <p><b>Bạn cần hỗ trợ điều gì?</b></p>
        <p>Nhắn tin tại đây — về đơn hàng, tiền hoàn, rút tiền hoặc tài khoản.</p>
      </div>
      {% for message in messages %}
        <div class="support-chat-row is-{{ message.authorRole | lower }}" data-message-id="{{ message.id }}">
          <div class="support-chat-bubble">
            <p>{{ message.body }}</p>
            <time datetime="{{ message.createdAt.toISOString() }}">{{ message.createdAt | datetime }}</time>
          </div>
        </div>
      {% endfor %}
    </div>

    <p class="support-chat-error" data-chat-error hidden role="alert"></p>

    <form class="support-chat-form" data-chat-form>
      <label class="visually-hidden" for="support-chat-input">Tin nhắn</label>
      <textarea id="support-chat-input" data-chat-input rows="1" maxlength="3000"
        placeholder="Nhập tin nhắn… (Enter để gửi, Shift+Enter xuống dòng)"
        autocomplete="off">{{ prefillMessage }}</textarea>
      <button class="button button-primary support-chat-send" type="submit" data-chat-send>
        Gửi
      </button>
    </form>
  </section>

{% endblock %}

{% block page_scripts %}
  <script src="/assets/support-chat.js?v={{ assetVersion }}" defer></script>
{% endblock %}
