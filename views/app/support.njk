{% extends "app/app-base.njk" %}

{% block app_content %}

  <section class="page-heading">
    <div>
      <h1>Hỗ trợ</h1>
      <p>Gửi yêu cầu theo mẫu cho từng đơn hàng, hoặc chat trực tiếp với đội CSKH.</p>
    </div>
  </section>

  <div class="support-layout">
    <section class="panel support-request-panel">
      <header class="panel-heading">
        <div>
          <h2>Gửi yêu cầu theo mẫu</h2>
          <p>Chọn đúng vấn đề và đơn hàng để được xử lý nhanh hơn.</p>
        </div>
      </header>

      <form class="stack-form support-request-form" data-support-form
        data-endpoint="/app/support/requests" data-csrf="{{ csrfToken }}" novalidate>
        <label for="support-topic-input">Vấn đề cần hỗ trợ
          <select id="support-topic-input" data-topic-select required>
            <option value="" selected disabled>Chọn vấn đề…</option>
            {% for topic in supportTopics %}
              <option value="{{ topic.value }}"
                data-order-mode="{{ topic.orderMode }}"
                data-order-required="{{ '1' if topic.orderRequired else '0' }}">{{ topic.label }}</option>
            {% endfor %}
          </select>
          <small class="field-error" id="support-topic-input-error" hidden></small>
        </label>

        <label for="support-order-input" data-order-block="list" hidden>Đơn hàng liên quan
          <select id="support-order-input" data-order-select>
            <option value="">— Chọn đơn hàng —</option>
            {% for option in orderOptions %}
              <option value="{{ option.key }}" {% if option.key == preselectOrderKey %}selected{% endif %}>{{ option.label }}</option>
            {% endfor %}
          </select>
          {% if not orderOptions.length %}
            <small>Tài khoản của bạn chưa có đơn nào trong lịch sử.</small>
          {% endif %}
          <small class="field-error" id="support-order-input-error" hidden></small>
        </label>

        <label for="support-order-code-input" data-order-block="code" hidden>Mã đơn hàng trên sàn
          <input id="support-order-code-input" data-order-code type="text" maxlength="100"
            autocomplete="off" placeholder="Ví dụ: 2508ABCXYZ123">
          <small>Xem trong mục đơn mua của Shopee / TikTok Shop / Lazada.</small>
          <small class="field-error" id="support-order-code-input-error" hidden></small>
        </label>

        <label for="support-description-input">Mô tả chi tiết
          <textarea id="support-description-input" data-description rows="4" maxlength="2000"
            placeholder="Bạn gặp vấn đề gì? (tối thiểu 10 ký tự)"></textarea>
          <small class="field-error" id="support-description-input-error" hidden></small>
        </label>

        <label for="support-email-input">Email nhận phản hồi
          <input id="support-email-input" data-notify-email type="email" maxlength="254"
            autocomplete="email" value="{{ notifyEmail }}">
          <small>Phản hồi của đội hỗ trợ cũng được gửi về email này.</small>
          <small class="field-error" id="support-email-input-error" hidden></small>
        </label>

        <p class="support-request-success" data-support-success hidden role="status">
          Đã gửi yêu cầu. Đội CSKH sẽ phản hồi trong khung chat.
        </p>
        <p class="field-error" data-support-error hidden role="alert"></p>

        <button class="button button-primary" type="submit" data-support-submit>Gửi yêu cầu</button>
      </form>
    </section>

    <section class="panel support-chat-panel" data-chat
      data-endpoint="/app/support/messages" data-csrf="{{ csrfToken }}">
      <header class="support-chat-head">
        <div class="support-chat-status">
          <span class="support-chat-dot {% if chatOnline %}is-online{% endif %}" aria-hidden="true"></span>
          <span>{% if chatOnline %}Đội CSKH đang trực — phản hồi sớm nhất có thể{% else %}Kênh chat đang bảo trì — tin nhắn vẫn được lưu lại{% endif %}</span>
        </div>
      </header>

      <div class="support-chat-messages" data-chat-messages tabindex="0"
        role="log" aria-label="Lịch sử trò chuyện" aria-live="polite">
        <div class="support-chat-empty" data-chat-empty {% if messages.length %}hidden{% endif %}>
          <p><b>Bạn cần hỗ trợ điều gì?</b></p>
          <p>Nhắn tin tại đây — về đơn hàng, tiền hoàn, rút tiền hoặc tài khoản.</p>
        </div>
        {% for message in messages %}
          <div class="support-chat-row is-{{ message.authorRole | lower }}" data-message-id="{{ message.id }}">
            <div class="support-chat-bubble">
              <p>{{ message.body }}</p>
              <time datetime="{{ message.createdAt.toISOString() }}">{{ message.createdAt | datetime }}</time>
            </div>
          </div>
        {% endfor %}
      </div>

      <p class="support-chat-error" data-chat-error hidden role="alert"></p>

      <form class="support-chat-form" data-chat-form>
        <label class="visually-hidden" for="support-chat-input">Tin nhắn</label>
        <textarea id="support-chat-input" data-chat-input rows="1" maxlength="3000"
          placeholder="Nhập tin nhắn… (Enter để gửi, Shift+Enter xuống dòng)"
          autocomplete="off">{{ prefillMessage }}</textarea>
        <button class="button button-primary support-chat-send" type="submit" data-chat-send>
          Gửi
        </button>
      </form>
    </section>
  </div>

{% endblock %}

{% block page_scripts %}
  <script src="/assets/support-request.js?v={{ assetVersion }}" defer></script>
{% endblock %}
