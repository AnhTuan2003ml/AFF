{% extends "app/app-base.njk" %}

{% block app_content %}

  <section class="page-heading">
    <div>
      <h1>Hỗ trợ</h1>
      <p>Gửi yêu cầu theo mẫu cho từng vấn đề. Đội CSKH xử lý riêng từng yêu cầu và phản hồi qua email cùng thông báo trên ứng dụng.</p>
    </div>
  </section>

  <div class="support-shell {% if latestRequest or latestReply %}has-reply{% endif %}">
    <section class="panel support-request-panel">
      <header class="panel-heading">
        <div>
          <h2>Gửi yêu cầu theo mẫu</h2>
          <p>Chọn đúng vấn đề và đơn hàng để được xử lý nhanh hơn.</p>
        </div>
      </header>

      {% if guest %}
        {# Khách: xem được mẫu yêu cầu nhưng phải đăng nhập mới gửi — đội CSKH
           cần biết tài khoản/đơn hàng để đối soát, và phản hồi về đúng hộp thư. #}
        <div class="px-alert support-guest-alert" role="status">
          <span class="mb-alert-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span>
          <div class="mb-alert-copy"><b>Đăng nhập để gửi yêu cầu hỗ trợ</b><small>Đội CSKH cần biết tài khoản và đơn hàng của bạn để đối soát; phản hồi về đúng hộp thư và thông báo trong ứng dụng.</small></div>
          <a class="button button-primary button-small" href="/dang-nhap?next=%2Fapp%2Fsupport">Đăng nhập</a>
        </div>
      {% endif %}
      <form class="stack-form support-request-form"{% if not guest %} data-support-form{% endif %}
        data-endpoint="/app/support/requests" data-csrf="{{ csrfToken }}" novalidate{% if guest %} aria-disabled="true"{% endif %}>
        <label for="support-topic-input">Vấn đề cần hỗ trợ
          <select id="support-topic-input" data-topic-select required{% if guest %} disabled{% endif %}>
            <option value="" selected disabled>Chọn vấn đề…</option>
            {% for topic in supportTopics %}
              <option value="{{ topic.value }}"
                data-order-mode="{{ topic.orderMode }}"
                data-order-required="{{ '1' if topic.orderRequired else '0' }}">{{ topic.label }}</option>
            {% endfor %}
          </select>
          <small class="field-error" id="support-topic-input-error" hidden></small>
        </label>

        <label for="support-order-input" data-order-block="list" hidden>Đơn hàng liên quan
          <select id="support-order-input" data-order-select>
            <option value="">— Chọn đơn hàng —</option>
            {% for option in orderOptions %}
              <option value="{{ option.key }}" {% if option.key == preselectOrderKey %}selected{% endif %}>{{ option.label }}</option>
            {% endfor %}
          </select>
          {% if not orderOptions.length %}
            <small>Tài khoản của bạn chưa có đơn nào trong lịch sử.</small>
          {% endif %}
          <small class="field-error" id="support-order-input-error" hidden></small>
        </label>

        <label for="support-order-code-input" data-order-block="code" hidden>Mã đơn hàng trên sàn
          <input id="support-order-code-input" data-order-code type="text" maxlength="100"
            autocomplete="off" placeholder="Ví dụ: 2508ABCXYZ123">
          <small>Xem trong mục đơn mua của Shopee / TikTok Shop / Lazada.</small>
          <small class="field-error" id="support-order-code-input-error" hidden></small>
        </label>

        <label for="support-description-input">Mô tả chi tiết
          <textarea id="support-description-input" data-description rows="4" maxlength="2000"
            placeholder="Bạn gặp vấn đề gì? (tối thiểu 10 ký tự)"{% if guest %} disabled{% endif %}></textarea>
          <small class="field-error" id="support-description-input-error" hidden></small>
        </label>

        <label for="support-email-input">Email nhận phản hồi
          <input id="support-email-input" data-notify-email type="email" maxlength="254"
            autocomplete="email" value="{{ notifyEmail }}"{% if guest %} disabled{% endif %}>
          <small>Phản hồi của đội hỗ trợ cũng được gửi về email này.</small>
          <small class="field-error" id="support-email-input-error" hidden></small>
        </label>

        <p class="support-request-success" data-support-success hidden role="status">
          Đã gửi yêu cầu. Đội CSKH sẽ xử lý và phản hồi qua email cùng thông báo trên ứng dụng.
        </p>
        <p class="field-error" data-support-error hidden role="alert"></p>

        {% if guest %}
          <a class="button button-primary" href="/dang-nhap?next=%2Fapp%2Fsupport">Đăng nhập để gửi yêu cầu</a>
        {% else %}
          <button class="button button-primary" type="submit" data-support-submit>Gửi yêu cầu</button>
        {% endif %}
      </form>
    </section>

    {% if latestRequest or latestReply %}
      <button type="button" class="support-reply-trigger" data-reply-open>
        Phản Hồi{% if latestReply %}<span class="support-reply-dot" aria-hidden="true"></span>{% endif %}
      </button>
      <aside class="panel support-thread-panel" data-reply-panel
        data-has-reply="{{ '1' if latestReply else '' }}" aria-label="Phản Hồi">
        <header class="panel-heading support-thread-head">
          <div>
            <h2>Phản Hồi</h2>
            <p>Yêu cầu hiện tại và phản hồi mới nhất từ đội CSKH.</p>
          </div>
          <button type="button" class="support-reply-close" data-reply-close aria-label="Đóng">×</button>
        </header>

        <div class="support-thread">
          {% if latestRequest %}
            <div class="support-msg is-user">
              <div class="support-msg-bubble">
                <b>Yêu cầu của bạn</b>
                <p>{{ latestRequest.body }}</p>
                <time datetime="{{ latestRequest.createdAt.toISOString() }}">{{ latestRequest.createdAt | datetime }}</time>
              </div>
            </div>
          {% endif %}
          {% if latestReply %}
            <div class="support-msg is-agent">
              <span class="support-msg-avatar" data-agent-mascot aria-hidden="true"></span>
              <div class="support-msg-bubble">
                <b>Đội CSKH</b>
                <p>{{ latestReply.body }}</p>
                <time datetime="{{ latestReply.createdAt.toISOString() }}">{{ latestReply.createdAt | datetime }}</time>
              </div>
            </div>
          {% else %}
            <p class="support-thread-waiting">Đội CSKH đang xử lý — phản hồi sẽ hiện tại đây và báo bằng linh vật.</p>
          {% endif %}
        </div>

        <div class="support-thread-foot">
          <span class="support-thread-foot-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 1.8"/></svg>
          </span>
          <span>Đội CSKH thường phản hồi trong vòng 24 giờ. Bạn sẽ nhận thông báo trên ứng dụng và email khi có phản hồi mới.</span>
        </div>
      </aside>
    {% endif %}
  </div>

{% endblock %}

{% block page_scripts %}
  {% if not guest %}
  <script src="/assets/support-request.js?v={{ assetVersion }}" defer></script>
  <script src="/assets/support-reply.js?v={{ assetVersion }}" defer></script>
  {% endif %}
{% endblock %}
