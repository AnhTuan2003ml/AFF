{% extends "app/app-base.njk" %}
{% from "partials/macros.njk" import status_badge, empty_state %}
{% from "partials/icons.njk" import icon %}

{% macro mission_row(item) %}
  {% set locked = item.progress < item.definition.threshold %}
  <div class="mission-row {{ 'mission-row-locked' if locked }}">
    <span class="mission-row-icon" aria-hidden="true">
      {% if item.claimStatus == 'APPROVED' %}
        {{ icon('mission-approved') }}
      {% elif item.claimStatus == 'REJECTED' %}
        {{ icon('mission-rejected') }}
      {% elif locked %}
        {{ icon('mission-locked') }}
      {% else %}
        {{ icon('mission') }}
      {% endif %}
    </span>

    <div class="mission-row-main">
      <b>{{ item.definition.title }}</b>
      <small>{{ item.progress }} / {{ item.definition.threshold }}</small>
    </div>

    <div class="mission-row-reward">
      <span class="mission-reward-gift" aria-hidden="true">{{ icon('gift') }}</span>
      <span>{{ t('Thưởng', 'Reward') }}</span>
      <b>{{ item.definition.rewardAmountVnd | vnd }}</b>
    </div>

    <div class="mission-row-action">
      {% if item.claimStatus == 'APPROVED' %}
        {{ status_badge('APPROVED', lang) }}
      {% elif item.claimStatus == 'REJECTED' %}
        {{ status_badge('REJECTED', lang) }}
      {% elif item.claimStatus == 'PENDING' %}
        {{ status_badge('PENDING', lang) }}
      {% elif item.claimable %}
        <form method="post" action="/app/nhiem-vu/claim">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="missionDefinitionId" value="{{ item.definition.id }}">
          <button type="submit" class="button button-primary button-small">{{ t('Nhận thưởng', 'Claim') }}</button>
        </form>
      {% else %}
        <span class="status-badge status-neutral">{{ t('Chưa đạt mốc', 'Not reached') }}</span>
      {% endif %}
    </div>
  </div>
{% endmacro %}

{% macro mission_group(group, unitLabel) %}
  <div class="mission-meter">
    <div class="mission-meter-head">
      <b>{{ group.currentProgress }}{% if group.maxThreshold %} / {{ group.maxThreshold }}{% endif %} {{ unitLabel }}</b>
    </div>
    {% if group.maxThreshold %}
      <div class="mission-meter-track">
        <div class="mission-meter-fill" data-pct="{{ group.fillPercent }}"></div>
        {% for item in group.items %}
          <span
            class="mission-meter-tick {{ 'mission-meter-tick-done' if item.progress >= item.definition.threshold }}"
            data-pct="{{ item.tickPercent }}"
            title="{{ item.definition.title }}: {{ item.definition.threshold }} {{ unitLabel }}"
          ></span>
        {% endfor %}
      </div>
      {% if group.currentProgress < group.maxThreshold %}
        <p class="mission-meter-note">{{ t('Còn', '') }} {{ group.maxThreshold - group.currentProgress }} {{ unitLabel }} {{ t('nữa để đạt mốc cao nhất.', 'to go to the top tier.') }}</p>
      {% else %}
        <p class="mission-meter-note mission-meter-note-done">{{ t('Bạn đã đạt mốc cao nhất!', 'You’ve reached the top tier!') }}</p>
      {% endif %}
    {% endif %}
  </div>

  {% if group.items.length %}
    <div class="mission-list-scroll">
      <div class="mission-list">
        {% for item in group.items %}{{ mission_row(item) }}{% endfor %}
      </div>
    </div>
  {% else %}
    {{ empty_state(t("Chưa có mốc nào", "No tiers yet"), t("Admin chưa thiết lập mốc thưởng cho mục này.", "The admin hasn’t set up reward tiers for this section yet."), compact=true) }}
  {% endif %}
{% endmacro %}

{% block app_content %}
  <header class="page-head">
    <div>
      <h1>{{ t('Nhiệm vụ và', 'Missions &') }} <em>{{ t('phần thưởng', 'rewards') }}</em></h1>
    </div>
  </header>

  <div class="mission-tabs" role="tablist" aria-label="{{ t('Loại nhiệm vụ', 'Mission type') }}">
    <button type="button" class="active" data-mission-tab="referral" aria-pressed="true">{{ icon('referral') }} {{ t('Mời người', 'Invite') }}</button>
    <button type="button" data-mission-tab="purchase" aria-pressed="false">{{ icon('orders') }} {{ t('Mua hàng', 'Shopping') }}</button>
  </div>

  <section class="mission-panel" data-mission-panel="referral">
    {{ mission_group(referralGroup, t('người', 'people')) }}

    <div class="mission-people">
      <div class="mission-people-head">
        <b>{{ t('Người bạn đã mời', 'People you invited') }}</b>
        <span class="mission-people-count">{{ referralPeople | length }} {{ t('người', 'people') }}</span>
      </div>
      {% if referralPeople | length %}
        <ul class="mission-people-list">
          {% for p in referralPeople %}
            <li class="mission-person {{ 'is-pending' if not p.qualified }}">
              <span class="mission-person-avatar" aria-hidden="true">{{ p.fullName | first | upper }}</span>
              <span class="mission-person-main">
                <b>{{ p.fullName }}</b>
                <small>{{ t('Tham gia', 'Joined') }} {{ p.joinedAt | date }}{% if p.approvedOrders %} · {{ p.approvedOrders }} {{ t('đơn đã duyệt', 'approved orders') }}{% endif %}</small>
              </span>
              {% if p.qualified %}
                <span class="status-badge status-positive">{{ t('Đã tính', 'Counted') }}</span>
              {% else %}
                <span class="status-badge status-pending">{{ t('Chờ xác nhận', 'Pending') }}</span>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        {{ empty_state(t("Chưa mời ai", "No invites yet"), t("Gửi mã giới thiệu cho bạn bè để bắt đầu tích lũy mốc thưởng.", "Share your referral code with friends to start earning reward tiers."), compact=true) }}
      {% endif %}
    </div>

    <div class="st-mission-cta">
      <a class="button button-primary" href="/app/referrals">{{ t('Mời bạn bè ngay', 'Invite friends now') }}</a>
    </div>
  </section>

  <section class="mission-panel" data-mission-panel="purchase" hidden>
    {{ mission_group(purchaseGroup, t('đơn', 'orders')) }}
    <div class="st-mission-cta">
      <a class="button button-primary" href="/app">{{ t('Tìm sản phẩm để mua', 'Find products to buy') }}</a>
    </div>
  </section>
{% endblock %}
