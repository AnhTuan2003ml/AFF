{% from "partials/charts.njk" import income_multiline_chart %}
<div class="income-breakdown">
  <div class="income-src is-own">
    <small>{{ t('Đơn của bạn', 'Your orders') }}</small>
    <b>{{ incomeBreakdown.ownVnd | vnd }}</b>
  </div>
  <div class="income-src is-referral">
    <small>{{ t('Người bạn giới thiệu', 'Referred users') }}</small>
    <b>{{ incomeBreakdown.referralVnd | vnd }}</b>
  </div>
  <div class="income-src is-shareLink">
    <small>{{ t('Mua qua link chia sẻ', 'Via shared links') }}</small>
    <b>{{ incomeBreakdown.shareLinkVnd | vnd }}</b>
  </div>
  <div class="income-src is-total">
    <small>{{ t('Tổng doanh thu', 'Total revenue') }}</small>
    <b>{{ incomeBreakdown.totalVnd | vnd }}</b>
  </div>
</div>
<div class="income-chart-wrap">
  {# Chú thích: mỗi nguồn doanh thu một màu. #}
  <ul class="income-legend">
    <li class="is-own"><span class="income-legend-dot"></span>{{ t('Đơn của bạn', 'Your orders') }}</li>
    <li class="is-referral"><span class="income-legend-dot"></span>{{ t('Người bạn giới thiệu', 'Referred users') }}</li>
    <li class="is-shareLink"><span class="income-legend-dot"></span>{{ t('Mua qua link chia sẻ', 'Via shared links') }}</li>
  </ul>
  {{ income_multiline_chart(referralIncomeChart, t('Biểu đồ doanh thu 3 nguồn theo thời gian', 'Revenue by 3 sources over time'), t('Chưa có doanh thu trong khoảng đã chọn.', 'No revenue in the selected range.')) }}
</div>
