{% extends "app/app-base.njk" %}
{% from "partials/icons.njk" import icon %}

{% macro lb2_row(item, rank, kind) %}
  {% if item %}
    <div class="lb2-row lb2-r{{ rank }}">
      <img class="lb2-medal" src="/assets/images/medal-{{ rank }}.png?v={{ assetVersion }}" alt="Hạng {{ rank }}" width="34">
      {% if kind == 'product' %}
        <span class="lb2-thumb">{% if item.imageUrl %}<img src="{{ item.imageUrl }}" alt="" loading="lazy" referrerpolicy="no-referrer">{% endif %}</span>
      {% else %}
        <span class="lb2-ava">{{ item.name | first | upper }}</span>
      {% endif %}
      <span class="lb2-name">{{ item.name }}</span>
      <span class="lb2-metric"><b>{{ item.count }}</b><small>đơn</small></span>
    </div>
  {% endif %}
{% endmacro %}

{% block app_content %}
  {% set defaultPlatform = "SHOPEE" if platformAvailability.SHOPEE else ("TIKTOK" if platformAvailability.TIKTOK else "LAZADA") %}

  <section class="px-home-hero" aria-labelledby="px-home-title">
    <div class="px-home-hero-bg" aria-hidden="true"></div>
    <div class="px-home-hero-shade" aria-hidden="true"></div>
    <div class="px-home-hero-copy">
      <span>SHOP · TRACK · CASHBACK</span>
      <h1 id="px-home-title">Mua sắm.<br>Hoàn tiền.<br>Rõ ràng.</h1>
      <div class="px-home-hero-actions">
        <a class="px-btn px-btn-light" href="#shop-search">Kiểm tra hoàn tiền</a>
        <a class="px-text-link px-text-link-light" href="/app/discover">Khám phá sản phẩm <span>→</span></a>
      </div>
    </div>
    {# Đăng nhập: số liệu ví thật. Khách: số liệu giới thiệu. #}
    {% if currentUser %}
    <div class="px-home-hero-meta">
      <span><b>{{ (balances.available or 0) | vnd }}</b><small>Số dư khả dụng</small></span>
      <span><b>{{ (balances.pending or 0) | vnd }}</b><small>Đang chờ về ví</small></span>
      <span><b>Hoàn tới {{ cashbackRate }}%</b><small>Đã mua {{ purchaseStats.products or 0 }} sản phẩm</small></span>
    </div>
    {% else %}
    <div class="px-home-hero-meta">
      <span><b>3 sàn</b><small>Shopee · TikTok · Lazada</small></span>
      <span><b>Hoàn tới {{ cashbackRate }}%</b><small>Về ví minh bạch</small></span>
      <span><b>Miễn phí</b><small>Không phí ẩn</small></span>
    </div>
    {% endif %}
  </section>

  <section class="px-section px-start" data-buy-flow data-platform-purchase='{{ platformAvailability | dump | safe }}' aria-label="Dán link kiểm tra hoàn tiền">
    <div class="px-start-grid">
      {% include "app/dashboard/product-search.njk" %}
      {% include "app/dashboard/wallet-card.njk" %}
    </div>

    {% include "app/dashboard/platform-tabs.njk" %}
  </section>

  {# Điểm danh: entry nổi bật kiểu sàn (Shopee/Lazada/TikTok) — icon + chuỗi +
     nút, mở popup lịch. Chỉ hiện khi đã đăng nhập. #}
  {% if currentUser %}
    <button type="button" class="checkin-entry" data-checkin-open aria-label="Mở điểm danh mỗi ngày">
      <span class="checkin-entry-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="16" rx="2.5"/><path d="M4 9.5h16M8 3v4M16 3v4"/><path d="m9 15 1.8 1.8 3.6-3.8"/></svg>
      </span>
      <span class="checkin-entry-copy">
        <b>Điểm danh mỗi ngày</b>
        <small>{% if checkin and checkin.checkedInToday %}Đã điểm danh hôm nay · giữ chuỗi liên tiếp{% else %}Điểm danh nhận thưởng · đừng để mất chuỗi{% endif %}</small>
      </span>
      {% if checkin and checkin.streak %}<span class="checkin-entry-streak" aria-label="Chuỗi {{ checkin.streak }} ngày">🔥 {{ checkin.streak }}</span>{% endif %}
      <span class="checkin-entry-cta">{% if checkin and checkin.checkedInToday %}Đã điểm danh ✓{% else %}Điểm danh{% endif %}</span>
    </button>
  {% endif %}

  {# Nhắc khi vào app: HIỂN THỊ SẢN PHẨM đã bấm Mua ngay nhưng chưa thành đơn
     (giữ 7 ngày). Trình bày như băng "Đề xuất": thẻ .promo-card, cuộn ngang,
     mũi tên/chấm dùng chung logic (data-promo-static: thẻ render sẵn từ server). #}
  {% if currentUser and interestedProducts and interestedProducts.length %}
    <section class="promo-carousel px-products-section interest-carousel" data-promo-carousel data-promo-static aria-label="Sản phẩm quan tâm chưa mua">
      <header class="px-section-head px-products-head interest-carousel-head">
        <div>
          <span class="px-eyebrow">CHƯA HOÀN TẤT</span>
          <h2>Sản phẩm bạn quan tâm</h2>
          <p>{{ interestedCount }} sản phẩm đã xem chưa mua — hoàn tất để nhận hoàn tiền.</p>
        </div>
        <a class="px-text-link" href="/app/orders">Xem tất cả <span aria-hidden="true">→</span></a>
      </header>
      <div class="promo-carousel-stage">
        <button type="button" class="promo-carousel-arrow promo-arrow-prev" data-promo-prev aria-label="Sản phẩm trước"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
        <div class="promo-carousel-viewport" data-promo-viewport>
          <div class="promo-carousel-track" data-promo-track>
            {% for p in interestedProducts %}
              <a class="promo-card pc-interest" href="/app/orders">
                <div class="promo-card-media">
                  {% if p.imageUrl %}<img src="{{ p.imageUrl }}" alt="" loading="lazy" referrerpolicy="no-referrer">{% else %}<span class="pc-interest-noimg" aria-hidden="true">▣</span>{% endif %}
                  <span class="promo-card-badge pc-interest-badge">Chưa mua</span>
                </div>
                <div class="promo-card-body pc-interest-body">
                  <p class="promo-card-name">{{ p.name }}</p>
                  <span class="pc-interest-cta">Hoàn tất mua <span aria-hidden="true">→</span></span>
                </div>
              </a>
            {% endfor %}
          </div>
        </div>
        <button type="button" class="promo-carousel-arrow promo-arrow-next" data-promo-next aria-label="Sản phẩm sau"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
      </div>
      <div class="promo-carousel-dots" data-promo-progress></div>
    </section>
  {% endif %}

  {% if not hasVerifiedBank %}
    <a class="mb-alert px-alert" href="/app/banks">
      <span class="mb-alert-icon" aria-hidden="true">{{ icon('bank') }}</span>
      <span class="mb-alert-copy"><b>Hoàn tất tài khoản nhận tiền.</b><small>Thêm và xác minh ngân hàng để có thể rút tiền hoàn khi đủ điều kiện.</small></span>
      <span class="mb-alert-go" aria-hidden="true">→</span>
    </a>
  {% endif %}

  {# Bảng vàng: một thẻ liền mạch, có bộ chuyển Người mua / Bán chạy (segmented)
     kèm vuốt ngang; top 1/2/3 có huy chương, hạng 1 nổi bật. #}
  {% if leaderboard and (leaderboard.topBuyers.length or leaderboard.topProducts.length) %}
    <section class="lb2-section" aria-label="Bảng vàng nền tảng">
      <div class="lb2-card">
        <div class="lb2-head">
          <div class="lb2-heading">
            <span class="lb2-trophy" aria-hidden="true">🏆</span>
            <div><span class="px-eyebrow">BẢNG VÀNG NỀN TẢNG</span><h2>Top ShopTik</h2></div>
          </div>
          <div class="lb2-seg" role="tablist" data-lb2-seg>
            <button type="button" class="is-active" data-lb2-tab="0" role="tab">Người mua</button>
            <button type="button" data-lb2-tab="1" role="tab">Bán chạy</button>
          </div>
        </div>
        <div class="lb2-viewport" data-lb2-viewport>
          <div class="lb2-track">
            <div class="lb2-panel">
              {{ lb2_row(leaderboard.topBuyers[0], 1, 'buyer') }}
              {{ lb2_row(leaderboard.topBuyers[1], 2, 'buyer') }}
              {{ lb2_row(leaderboard.topBuyers[2], 3, 'buyer') }}
            </div>
            <div class="lb2-panel">
              {{ lb2_row(leaderboard.topProducts[0], 1, 'product') }}
              {{ lb2_row(leaderboard.topProducts[1], 2, 'product') }}
              {{ lb2_row(leaderboard.topProducts[2], 3, 'product') }}
            </div>
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  {# 3 băng sản phẩm — mỗi mục MỘT HÀNG, nạp riêng theo list. #}
  {% for row in [
    { list: 'recommend', title: 'Đề xuất' },
    { list: 'best', title: 'Bán chạy' },
    { list: 'exclusive', title: 'Ưu đãi độc quyền' }
  ] %}
    <section class="promo-carousel px-products-section" data-promo-carousel data-endpoint="/app/promo-products?list={{ row.list }}" hidden aria-label="{{ row.title }}">
      <header class="px-section-head px-products-head">
        <div><h2>{{ row.title }}</h2></div>
      </header>
      {# Vuốt ngang để lướt (scroll-snap, không cần bấm nút). Mũi tên đặt ở 2 mép
         trái/phải cho desktop; ẩn trên mobile vì đã vuốt được. #}
      <div class="promo-carousel-stage">
        <button type="button" class="promo-carousel-arrow promo-arrow-prev" data-promo-prev aria-label="Sản phẩm trước"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
        <div class="promo-carousel-viewport" data-promo-viewport><div class="promo-carousel-track" data-promo-track></div></div>
        <button type="button" class="promo-carousel-arrow promo-arrow-next" data-promo-next aria-label="Sản phẩm sau"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
      </div>
      <div class="promo-carousel-dots" data-promo-progress></div>
    </section>
  {% endfor %}
{% endblock %}

{% block page_scripts %}
  <script src="/assets/purchase.js?v={{ assetVersion }}" defer></script>
  <script src="/assets/promo-carousel.js?v={{ assetVersion }}" defer></script>
  <script src="/assets/leaderboard.js?v={{ assetVersion }}" defer></script>
{% endblock %}
