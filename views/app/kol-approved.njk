{% extends "app/app-base.njk" %}

{% block app_content %}
  <link rel="stylesheet" href="/assets/kol.css?v={{ assetVersion }}">
  <section class="kol-wrap">
    <header class="kol-head">
      <span class="kol-eyebrow">{{ t('ĐỐI TÁC KOL/KOC', 'KOL/KOC PARTNER') }}</span>
      <h1>{{ t('Bạn đã là đối tác chính thức', 'You’re now an official partner') }}</h1>
      <p>{{ t('Hồ sơ của bạn đã được duyệt. Dưới đây là thông tin đã đăng ký, ảnh xác minh và hợp đồng hợp tác.', 'Your application is approved. Below is your registered info, verification media and partnership contract.') }}</p>
    </header>

    <div class="kol-approved-badge">✓ {{ t('Đã duyệt — không cần đăng ký lại', 'Approved — no need to reapply') }}</div>

    <div class="kol-card">
      <h2 class="kol-card-title">{{ t('Thông tin đã đăng ký', 'Registered information') }}</h2>
      <dl class="kol-approved-info">
        <div><dt>{{ t('Họ và tên', 'Full name') }}</dt><dd>{{ a.full_name }}</dd></div>
        <div><dt>{{ t('Số CCCD', 'ID number') }}</dt><dd>{{ a.cccd_number }}</dd></div>
        <div><dt>{{ t('Ngày sinh', 'Date of birth') }}</dt><dd>{{ a.birth_date or '—' }}</dd></div>
        <div><dt>{{ t('Ngày cấp / Nơi cấp', 'Issue date / place') }}</dt><dd>{{ a.cccd_issue or '—' }}</dd></div>
        <div><dt>{{ t('Điện thoại', 'Phone') }}</dt><dd>{{ a.phone }}</dd></div>
        <div><dt>Email</dt><dd>{{ a.email or '—' }}</dd></div>
        <div class="kol-col-2"><dt>{{ t('Ngân hàng nhận tiền', 'Payout bank') }}</dt><dd>{{ a.bank_account or '—' }} {{ a.bank_name or '' }}</dd></div>
        <div class="kol-col-2"><dt>{{ t('Địa chỉ', 'Address') }}</dt><dd>{{ a.address or '—' }}</dd></div>
      </dl>
    </div>

    <div class="kol-card">
      <h2 class="kol-card-title">{{ t('Ảnh & video xác minh', 'Verification media') }}</h2>
      <div class="kol-admin-kyc">
        <figure><figcaption>{{ t('CCCD mặt trước', 'ID front') }}</figcaption>
          <img src="/app/dang-ky-kol/file/cccd_front" alt="{{ t('CCCD trước', 'ID front') }}" loading="lazy"></figure>
        <figure><figcaption>{{ t('CCCD mặt sau', 'ID back') }}</figcaption>
          <img src="/app/dang-ky-kol/file/cccd_back" alt="{{ t('CCCD sau', 'ID back') }}" loading="lazy"></figure>
        <figure><figcaption>{{ t('Video khuôn mặt', 'Face video') }}</figcaption>
          <video src="/app/dang-ky-kol/file/face_video" controls preload="metadata" playsinline></video></figure>
      </div>
    </div>

    {% if a.has_contract %}
      <div class="kol-card">
        <h2 class="kol-card-title">{{ t('Hợp đồng hợp tác', 'Partnership contract') }}</h2>
        <p class="kol-note">{{ t('Bản hợp đồng đã được gửi tới email của bạn. Bạn có thể tải lại tại đây.', 'The contract has been emailed to you. You can download it again here.') }}</p>
        <a class="button button-primary" href="/app/dang-ky-kol/file/contract_pdf" target="_blank" rel="noopener">⬇ {{ t('Tải hợp đồng (PDF)', 'Download contract (PDF)') }}</a>
      </div>
    {% endif %}
  </section>
{% endblock %}
