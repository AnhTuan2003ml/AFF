{% extends "app/app-base.njk" %}

{% block app_content %}
  <link rel="stylesheet" href="/assets/kol.css?v={{ assetVersion }}">
  <section class="kol-wrap">
    <header class="kol-head">
      <span class="kol-eyebrow">ĐĂNG KÝ ĐỐI TÁC</span>
      <h1>Trở thành KOL/KOC ShopTik</h1>
      <p>Đọc và đồng ý Thỏa thuận hợp tác, sau đó điền hồ sơ và xác minh danh tính. Được duyệt, bạn thành đối tác đặc biệt — hưởng hoa hồng cao hơn.</p>
    </header>

    {% if pendingStatus == 'PENDING' %}
      <div class="kol-status kol-status-pending">
        <b>⏳ Hồ sơ đang chờ duyệt</b>
        <p>Đội ngũ đang xét hồ sơ của bạn. Có kết quả bạn sẽ nhận thông báo.</p>
      </div>
    {% else %}
      {% if pendingStatus == 'REJECTED' %}
        <div class="kol-status kol-status-reject"><b>Hồ sơ trước chưa được duyệt</b><p>Bạn có thể nộp lại sau khi chỉnh sửa.</p></div>
      {% endif %}

      <article class="kol-terms" aria-label="Thỏa thuận hợp tác KOL/KOC">
        {% for p in paragraphs %}
          {% set upper = p | upper %}
          {% if p == upper and p | length < 90 %}
            <h3>{{ p }}</h3>
          {% elif p | lower | truncate(5, true, '') == 'điều ' %}
            <h4>{{ p }}</h4>
          {% else %}
            <p>{{ p }}</p>
          {% endif %}
        {% endfor %}
      </article>

      <form method="get" action="/app/dang-ky-kol/thong-tin" class="kol-agree-bar" id="kol-agree-form">
        <input type="hidden" name="dong_y" value="1">
        <label class="kol-check">
          <input type="checkbox" id="kol-accept" required>
          <span>Tôi đã đọc và <b>đồng ý</b> toàn bộ Thỏa thuận hợp tác KOL/KOC và Cam kết bảo mật thông tin.</span>
        </label>
        <button class="button button-primary kol-continue" type="submit" id="kol-continue" disabled>Tiếp tục →</button>
      </form>
    {% endif %}
  </section>
  <script>
    (function () {
      var c = document.getElementById('kol-accept');
      var b = document.getElementById('kol-continue');
      if (c && b) c.addEventListener('change', function () { b.disabled = !c.checked; });
    })();
  </script>
{% endblock %}
