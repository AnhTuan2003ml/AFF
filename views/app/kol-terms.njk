{% extends "app/app-base.njk" %}

{% block app_content %}
  <link rel="stylesheet" href="/assets/kol.css?v={{ assetVersion }}">
  <section class="kol-wrap">
    <header class="kol-head">
      <span class="kol-eyebrow">ĐĂNG KÝ ĐỐI TÁC · BƯỚC 1/2</span>
      <h1>Thỏa thuận hợp tác KOL/KOC</h1>
      <p>Vui lòng đọc kỹ toàn bộ thỏa thuận và chính sách bên dưới. Tích xác nhận ở cuối trang để tiếp tục sang bước điền hồ sơ.</p>
    </header>

    {% if pendingStatus == 'PENDING' %}
      <div class="kol-status kol-status-pending">
        <b>⏳ Hồ sơ đang chờ duyệt</b>
        <p>Đội ngũ đang xét hồ sơ của bạn. Có kết quả bạn sẽ nhận thông báo.</p>
      </div>
    {% else %}
      {% if pendingStatus == 'REJECTED' %}
        <div class="kol-status kol-status-reject"><b>Hồ sơ trước chưa được duyệt</b><p>Bạn có thể nộp lại sau khi chỉnh sửa.</p></div>
      {% endif %}

      <article class="kol-doc" aria-label="Thỏa thuận hợp tác KOL/KOC" tabindex="0">
        <div class="kol-doc-sheet">
          {% for p in paragraphs %}
            {% set upper = p | upper %}
            {% set isDieu = (p | lower | truncate(5, true, '')) == 'điều ' %}
            {% if isDieu %}
              <h3 class="kol-dieu">{{ p }}</h3>
            {% elif p == upper and (p | length) < 90 %}
              <h2 class="kol-doc-title">{{ p }}</h2>
            {% elif p | truncate(8, true, '') == 'Độc lập' or p == 'Căn cứ:' %}
              <p class="kol-doc-sub">{{ p }}</p>
            {% else %}
              <p>{{ p }}</p>
            {% endif %}
          {% endfor %}
        </div>
      </article>

      <form method="get" action="/app/dang-ky-kol/thong-tin" class="kol-agree-bar" id="kol-agree-form">
        <input type="hidden" name="dong_y" value="1">
        <label class="kol-check" for="kol-accept">
          <input type="checkbox" id="kol-accept" required>
          <span class="kol-check-box" aria-hidden="true"></span>
          <span class="kol-check-text">Tôi đã đọc và <b>đồng ý</b> toàn bộ Thỏa thuận hợp tác KOL/KOC và Cam kết bảo mật thông tin.</span>
        </label>
        <button class="button button-primary kol-continue" type="submit" id="kol-continue" disabled>Tiếp tục điền hồ sơ →</button>
      </form>
    {% endif %}
  </section>
  <script src="/assets/kol-terms.js?v={{ assetVersion }}" defer></script>
{% endblock %}
