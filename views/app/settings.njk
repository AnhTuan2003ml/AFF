{% extends "app/app-base.njk" %}
{% from "partials/icons.njk" import icon %}

{#
  Trang "Chức năng" — đích của tab giữa-phải trên thanh dưới mobile.
  CHỈ điều hướng: đây là chỗ trả lời "đi đâu", không phải chỗ sửa gì. Mọi
  trường hồ sơ và bảo mật nằm ở /app/profile để trang này không phình ra khi
  thêm ảnh đại diện, số điện thoại, ngày sinh...
#}

{% block app_content %}
  {% set profileBalances = headerBalances or balances %}
  <a class="mb-profile mb-profile-link" href="/app/profile" aria-label="Xem thông tin cá nhân">
    <span class="mb-profile-avatar" aria-hidden="true">
      {% if currentUser.avatarUrl %}<img src="{{ currentUser.avatarUrl }}" alt="" referrerpolicy="no-referrer">{% else %}<span>{{ (currentUser.fullName or currentUser.email or '?') | first | upper }}</span>{% endif %}
    </span>
    <span class="mb-profile-copy">
      <b>{{ currentUser.fullName or 'Tài khoản ShopTik' }}</b>
      <small>{{ currentUser.email }}</small>
    </span>
    {% if profileBalances %}
      <span class="mb-profile-stats">
        <span class="is-pending">
          <span>Đang chờ</span>
          <b>{{ profileBalances.pending | vnd }}</b>
        </span>
        <span>
          <span>Khả dụng</span>
          <b>{{ profileBalances.available | vnd }}</b>
        </span>
      </span>
    {% endif %}
    <span class="mb-profile-go" aria-hidden="true">›</span>
  </a>

  <section class="mb-panel" aria-label="Tài khoản">
    <div class="mb-panel-head">
      <h2 class="mb-panel-title">Tài khoản</h2>
    </div>
    <div class="mb-linklist">
      <a class="mb-linkrow" href="/app/profile">{{ icon('user') }}<span>Thông tin cá nhân</span></a>
      <a class="mb-linkrow" href="/app/banks">{{ icon('bank') }}<span>Tài khoản nhận tiền</span></a>
    </div>
  </section>

  <section class="mb-panel" aria-label="Tiền và đơn hàng">
    <div class="mb-panel-head">
      <h2 class="mb-panel-title">Tiền và đơn hàng</h2>
    </div>
    <div class="mb-linklist">
      <a class="mb-linkrow" href="/app/wallet">{{ icon('wallet') }}<span>Số dư &amp; lịch sử ví</span></a>
      <a class="mb-linkrow" href="/app/withdrawals">{{ icon('withdraw') }}<span>Rút tiền về ngân hàng</span></a>
      <a class="mb-linkrow" href="/app/orders">{{ icon('orders') }}<span>Đơn hàng &amp; đối soát</span></a>
      <a class="mb-linkrow" href="/app/nhiem-vu">{{ icon('mission') }}<span>Nhiệm vụ nhận thưởng</span></a>
    </div>
  </section>

  <section class="mb-panel" aria-label="Kiếm thêm">
    <div class="mb-panel-head">
      <h2 class="mb-panel-title">Kiếm thêm</h2>
    </div>
    <div class="mb-linklist">
      <a class="mb-linkrow" href="/app/links">{{ icon('link') }}<span>Link chia sẻ</span></a>
      <a class="mb-linkrow" href="/app/referrals">{{ icon('referral') }}<span>Giới thiệu bạn bè</span></a>
      <a class="mb-linkrow" href="/app/discover">{{ icon('compass') }}<span>Khám phá ưu đãi</span></a>
    </div>
  </section>

  <section class="mb-panel" aria-label="Khác">
    <div class="mb-panel-head">
      <h2 class="mb-panel-title">Khác</h2>
    </div>
    <div class="mb-linklist">
      <a class="mb-linkrow" href="/app/support">{{ icon('support') }}<span>Hỗ trợ &amp; khiếu nại</span></a>
      <a class="mb-linkrow" href="/chinh-sach-nguoi-dung" data-user-policy-link>{{ icon('audit') }}<span>Chính sách người dùng</span></a>
      {% if currentUser.role != 'USER' %}
        <a class="mb-linkrow" href="/backoffice/console">{{ icon('ops') }}<span>Mở trang quản trị</span></a>
      {% endif %}
      <form method="post" action="/dang-xuat">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {# class button-ghost để rule CTA đỏ của dv13 tự loại trừ nút này #}
        <button class="mb-linkrow is-danger button-ghost" type="submit">{{ icon('logout') }}<span>Đăng xuất</span></button>
      </form>
    </div>
  </section>
{% endblock %}
