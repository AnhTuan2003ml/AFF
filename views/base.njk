<!doctype html>
{# theme_attr: mặc định RỖNG — mọi trang theo sáng/tối của MÁY
   (theme-init.js đặt data-theme trước khi vẽ; khu khách có bảng tối ở
   luxury-dark.css, khu quản trị có bảng tối riêng). Trang nào cần ép
   một theme cố định thì override block này. #}
<html lang="{{ 'en' if lang == 'en' else 'vi' }}" {% block theme_attr %}{% endblock %} {% block html_attrs %}{% endblock %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#ee4d2d">
  <meta name="description" content="ShopTik giúp tìm sản phẩm, mua qua Affiliate và nhận hoàn tiền minh bạch.">
  <meta name="google-site-verification" content="googled69bfa970903b549.html">
  <meta name="csrf-token" content="{{ csrfToken }}">
  <title>{{ pageTitle }} · {{ appName }}</title>
  <link rel="manifest" href="/assets/manifest.webmanifest">
  <link rel="icon" href="/assets/images/icon.png?v={{ assetVersion }}" sizes="any">
  <link rel="shortcut icon" href="/assets/images/icon.png?v={{ assetVersion }}">
  <link rel="apple-touch-icon" href="/assets/images/icon-192.png?v={{ assetVersion }}">
  {% block base_styles %}
    <link rel="stylesheet" href="/assets/luxury-ui.css?v={{ assetVersion }}">
    <link rel="stylesheet" href="/assets/luxury-dark.css?v={{ assetVersion }}">
  {% endblock %}
  {# Chuyển trang mượt + thanh tiến trình thương hiệu. #}
  <link rel="stylesheet" href="/assets/ui-motion.css?v={{ assetVersion }}">
  <script src="/assets/ui-motion.js?v={{ assetVersion }}" defer></script>
  <script src="/assets/theme-init.js?v={{ assetVersion }}"></script>
  <script src="/assets/backoffice-product-integrity.js?v={{ assetVersion }}" defer></script>
  <script src="/assets/app.js?v={{ assetVersion }}" defer></script>
  <script src="/assets/ux-integrity.js?v={{ assetVersion }}" defer></script>
  <script src="/assets/backoffice-integrity.js?v={{ assetVersion }}" defer></script>
  <script src="/assets/user-policy.js?v={{ assetVersion }}" defer></script>
  {% block page_scripts %}{% endblock %}
</head>
<body class="{{ bodyClass or '' }}">
  <a class="skip-link" href="#main-content">{{ t('Bỏ qua menu', 'Skip to content') }}</a>
  {% block body %}
    {# Khung cho các trang công khai ngoài app: điều khoản, quyền riêng tư,
       chính sách người dùng, trang lỗi. Header và footer lấy nguyên từ partial
       dùng chung với trang đăng nhập/đăng ký nên ba nơi luôn giống hệt nhau. #}
    {% include "partials/public-header.njk" %}
    <main id="main-content">
      {% block content %}{% endblock %}
    </main>
    {% include "partials/public-footer.njk" %}
  {% endblock %}
  {% include "partials/user-policy-modal.njk" %}
</body>
</html>
