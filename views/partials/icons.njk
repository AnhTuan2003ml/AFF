{#
  Bộ icon độc quyền ShopTik — vẽ tay trên lưới 24px, nét 1.9 bo tròn.
  Chữ ký nhận diện: mỗi icon có một "chấm coin" đặc (fill) đặt lệch —
  motif tiền hoàn của thương hiệu. Không sao chép bộ icon có sẵn.
#}
{% macro icon(name) %}
  {%- if name == 'search' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
  {%- elif name == 'plus' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
  {%- elif name == 'upload' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M5 14v5h14v-5"/></svg>
  {%- elif name == 'dashboard' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.2 11.2c0-1 .46-1.94 1.24-2.56l5.3-4.2a2 2 0 0 1 2.5 0l5.32 4.2a3.2 3.2 0 0 1 1.24 2.56v6a3 3 0 0 1-3 3H7.2a3 3 0 0 1-3-3z"/><path d="M9.6 20v-4.2a2.4 2.4 0 0 1 4.8 0V20"/><circle cx="16.6" cy="9.4" r="1.15" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'link' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.4 15.2 15 9.6"/><path d="M11.8 6.4 13.6 4.6a3.8 3.8 0 0 1 5.4 5.4l-1.8 1.8"/><path d="M12.2 17.6 10.4 19.4a3.8 3.8 0 0 1-5.4-5.4l1.8-1.8"/><circle cx="18.9" cy="5.1" r="1.1" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'orders' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4.6a1.6 1.6 0 0 1 1.6-1.6h8.8A1.6 1.6 0 0 1 18 4.6v15l-2-1.3-2 1.3-2-1.3-2 1.3-2-1.3-2 1.3z"/><path d="M9.2 8.4h5.6M9.2 11.8h5.6M9.2 15.2h2.6"/><circle cx="14.9" cy="15.2" r="1.05" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'discover' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.6"/><path d="m15.7 15.7 4.5 4.5"/><path d="M7.8 10.2a3.1 3.1 0 0 1 2.4-2.3"/><circle cx="13.3" cy="13" r="1.05" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'wallet' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8.4A2.4 2.4 0 0 1 6.4 6h10.4a1.2 1.2 0 0 1 1.2 1.2v1"/><rect x="4" y="8.4" width="16.4" height="11" rx="2.4"/><path d="M15.4 13.9h5"/><circle cx="15.6" cy="13.9" r="1.15" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'withdraw' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.4" y="9.2" width="17.2" height="10" rx="2.4"/><path d="M12 2.8v4M9.7 4.9 12 7l2.3-2.1"/><path d="M7 14.2h.01M17 14.2h.01"/><circle cx="12" cy="14.2" r="2.1"/><circle cx="12" cy="14.2" r="0.7" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'bank' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4.6" width="16" height="14.8" rx="3"/><circle cx="12" cy="12" r="3.6"/><path d="M12 8.4v1.4M12 14.2v1.4M8.4 12h1.4M14.2 12h1.4"/><circle cx="12" cy="12" r="0.85" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'referral' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7.2" r="3"/><path d="M12 10.2c0 3.4-3.4 3-5.4 5.1A3.4 3.4 0 0 0 5.6 18M12 10.2c0 3.4 3.4 3 5.4 5.1a3.4 3.4 0 0 1 1 2.7"/><circle cx="5.6" cy="19.4" r="1.5"/><circle cx="18.4" cy="19.4" r="1.5"/><circle cx="12" cy="7.2" r="0.85" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'support' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.6 13.2v-1.4a7.4 7.4 0 0 1 14.8 0v1.4"/><rect x="3.4" y="12.6" width="3.6" height="5.4" rx="1.6"/><rect x="17" y="12.6" width="3.6" height="5.4" rx="1.6"/><path d="M18.8 18v.6a2.6 2.6 0 0 1-2.6 2.6h-2.4"/><circle cx="12.6" cy="21.2" r="1.05" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'settings' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.2 8h10M18.6 8h1.2M4.2 16h3.4M12 16h7.8"/><circle cx="16.2" cy="8" r="2.3"/><circle cx="9.6" cy="16" r="2.3"/><circle cx="9.6" cy="16" r="0.8" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'users' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9.2" cy="8.4" r="3.2"/><path d="M3.6 19.2a5.6 5.6 0 0 1 11.2 0"/><path d="M15.4 5.5a3.2 3.2 0 0 1 0 5.8M17.4 14.6a5.6 5.6 0 0 1 3 4.6"/><circle cx="15.9" cy="8.4" r="0.85" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'ops' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.4 18.8 6a1.6 1.6 0 0 1 1 1.5V12c0 4.6-3.2 7.8-7.8 9-4.6-1.2-7.8-4.4-7.8-9V7.5a1.6 1.6 0 0 1 1-1.5z"/><path d="m8.9 12.2 2.1 2.1 4.1-4.2"/><circle cx="12" cy="18.1" r="0.85" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'audit' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.4 5a1.8 1.8 0 0 1 1.8-1.8h7L17.4 6v6.2"/><path d="M5.4 5v14a1.8 1.8 0 0 0 1.8 1.8h5.2"/><path d="M8.6 8.6h5M8.6 12h4"/><circle cx="16.2" cy="16.2" r="3.1"/><path d="m18.5 18.5 2.3 2.3"/><circle cx="16.2" cy="16.2" r="0.8" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'app-return' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.2 12H5.6M10.8 6.4 5.2 12l5.6 5.6"/><circle cx="19.6" cy="12" r="1.05" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'warning' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.3 4.8a2 2 0 0 1 3.4 0l6.5 11.4a2 2 0 0 1-1.7 3H5.5a2 2 0 0 1-1.7-3z"/><path d="M12 9.6v4"/><circle cx="12" cy="16.2" r="1" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'more' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5.8" cy="12" r="1.4" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/><circle cx="18.2" cy="12" r="1.4" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'chevron-down' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
  {%- elif name == 'refresh' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12a7 7 0 0 1 12.1-4.9"/><path d="M19 12a7 7 0 0 1-12.1 4.9"/><path d="M17.5 4.4v3.3h-3.3M6.5 19.6v-3.3h3.3"/><circle cx="12" cy="12" r="0.85" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'paste' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6.2" y="4.6" width="11.6" height="16.4" rx="2.2"/><path d="M9.4 4.6v-.9a1.3 1.3 0 0 1 1.3-1.3h2.6a1.3 1.3 0 0 1 1.3 1.3v.9"/><path d="M9.4 11h5.2M9.4 14.6h3.4"/><circle cx="9.6" cy="7.8" r="0.85" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'mission' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.6 18.4 6v6c0 4.6-2.9 7.6-6.4 8.8-3.5-1.2-6.4-4.2-6.4-8.8V6z"/><path d="m9.1 12.1 2 2 3.8-3.9"/><circle cx="12" cy="3.6" r="0.85" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'bell' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 10.4a6 6 0 0 1 12 0c0 4 1.4 5.4 1.4 5.4H4.6S6 14.4 6 10.4Z"/><path d="M9.6 18.8a2.4 2.4 0 0 0 4.8 0"/><circle cx="17.4" cy="5.6" r="1.05" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'logout' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.2 4.2H6.4a2.2 2.2 0 0 0-2.2 2.2v11.2a2.2 2.2 0 0 0 2.2 2.2h3.8"/><path d="M14.2 7.4 18.8 12l-4.6 4.6M18.4 12H9.2"/><circle cx="19" cy="12" r="0.85" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'mission-approved' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.4"/><path d="m8.6 12.2 2.4 2.4 4.6-4.8"/><circle cx="12" cy="3.6" r="0.85" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'mission-rejected' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.4"/><path d="m9.2 9.2 5.6 5.6M14.8 9.2l-5.6 5.6"/><circle cx="12" cy="3.6" r="0.85" fill="currentColor" stroke="none"/></svg>
  {%- elif name == 'mission-locked' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5.6" y="10.6" width="12.8" height="9" rx="2.4"/><path d="M8.6 10.6V8a3.4 3.4 0 0 1 6.8 0v2.6"/><circle cx="12" cy="15.1" r="0.9" fill="currentColor" stroke="none"/></svg>
  {%- endif -%}
{% endmacro %}
