{#
  Thanh trên cùng cho các trang công khai ngoài app: điều khoản, quyền riêng tư,
  chính sách người dùng, trang lỗi.

  Dùng đúng bộ class .px-header/.px-brand/.px-desktop-nav như header của /app ở
  trạng thái CHƯA đăng nhập, nên khách đi từ trang chủ sang trang pháp lý không
  thấy đổi khung. Sửa header khách trong app/app-base.njk thì soát lại file này.
#}
<header class="px-header">
  <div class="px-header-inner">
    <a class="px-brand" href="/app" aria-label="ShopTik - Trang chủ">
      <img src="/assets/images/icon.png?v={{ assetVersion }}" alt="" aria-hidden="true">
      <span>ShopTik</span>
    </a>

    <nav class="px-desktop-nav" aria-label="{{ t('Điều hướng chính', 'Main navigation') }}">
      <a href="/app">{{ t('Trang chủ', 'Home') }}</a>
      <a href="/app/discover">{{ t('Khám phá', 'Discover') }}</a>
      <a href="/app/orders">{{ t('Đơn hàng', 'Orders') }}</a>
      <a href="/app/wallet">{{ t('Ví', 'Wallet') }}</a>
      <a href="/app/nhiem-vu">{{ t('Nhiệm vụ', 'Missions') }}</a>
      <a href="/app/links">{{ t('Chia sẻ', 'Share') }}</a>
      <a href="/app/referrals">{{ t('Giới thiệu', 'Refer') }}</a>
      <a href="/app/support">{{ t('Hỗ trợ', 'Support') }}</a>
    </nav>

    <div class="px-header-actions">
      {# Chọn ngôn ngữ ngay trên header (không để lọt xuống chân trang). Dùng
         đúng globe dropdown như header /app để hai nơi giống nhau. #}
      <details class="px-lang-menu">
        <summary class="px-head-icon px-lang-trigger" aria-label="{{ t('Ngôn ngữ', 'Language') }}" title="{{ t('Ngôn ngữ', 'Language') }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.6 2.7 2.6 15.3 0 18M12 3c-2.6 2.7-2.6 15.3 0 18"/></svg>
          <span class="px-lang-code">{{ 'VI' if lang == 'vi' else 'EN' }}</span>
        </summary>
        <div class="px-lang-panel" role="menu">
          <a href="/lang/vi?next={{ currentPath | urlencode }}" role="menuitem"{% if lang == 'vi' %} class="active" aria-current="true"{% endif %}>🇻🇳 Tiếng Việt</a>
          <a href="/lang/en?next={{ currentPath | urlencode }}" role="menuitem"{% if lang == 'en' %} class="active" aria-current="true"{% endif %}>🇬🇧 English</a>
        </div>
      </details>
      <a class="px-btn px-btn-ghost px-guest-login" href="/dang-nhap">{{ t('Đăng nhập', 'Sign in') }}</a>
      <a class="px-btn px-btn-dark px-guest-register" href="/dang-ky">{{ t('Đăng ký', 'Sign up') }}</a>
    </div>
  </div>
</header>
