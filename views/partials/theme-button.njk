{# Nút đổi giao diện dạng icon 44×44 đặt trên topbar (thay cho công tắc
   track/thumb cũ ở sidebar). Icon thể hiện HÀNH ĐỘNG sắp thực hiện:
   đang sáng → hiện mặt trăng ("Bật giao diện tối"), đang tối → mặt trời.
   app.js cập nhật aria-label/title theo theme hiện tại; CSS trong
   app-shell.css chọn icon hiển thị theo data-theme. #}
<button type="button" class="st-icon-button st-theme-button" data-theme-toggle role="switch" aria-checked="false" aria-pressed="false" aria-label="Bật giao diện tối" title="Bật giao diện tối">
  <svg class="st-theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.2A8.4 8.4 0 1 1 9.8 4a6.6 6.6 0 0 0 10.2 10.2z"/></svg>
  <svg class="st-theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2.5v2.6M12 18.9v2.6M4.6 4.6l1.9 1.9M17.5 17.5l1.9 1.9M2.5 12h2.6M18.9 12h2.6M4.6 19.4l1.9-1.9M17.5 6.5l1.9-1.9"/></svg>
</button>
