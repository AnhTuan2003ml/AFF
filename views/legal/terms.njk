{% extends "base.njk" %}

{% block content %}
  <article class="legal-page policy-page">
    <span class="eyebrow">{{ t('PHIÊN BẢN', 'VERSION') }} {{ doc.version }}</span>
    <h1>{{ doc.title }}</h1>
    <div class="policy-layout">
      <aside class="policy-toc-aside">
        {% set tocSections = doc.sections %}
        {% set tocPrefix = "" %}
        {% include "legal/legal-toc.njk" %}
      </aside>
      <div class="policy-content">
        {% include "legal/legal-doc-body.njk" %}
      </div>
    </div>
  </article>
{% endblock %}
